@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmar Email";
}

<div class="identity-layout">
    <div class="auth-card" style="max-width: 600px;">
        <div class="auth-header">
            <div style="width: 80px; height: 80px; margin: 0 auto 24px; background: linear-gradient(135deg, #FF3B30, #FF6B5E); border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 40px rgba(255, 59, 48, 0.3);">
                <i class="bi bi-envelope-check" style="font-size: 2.5rem; color: white;"></i>
            </div>
            <h2>@ViewData["Title"]</h2>
            <p style="margin-top: 16px;">@Model.StatusMessage</p>
        </div>

        @if (Model.IsSuccess)
        {
            <div style="background: rgba(16, 185, 129, 0.1); border: 2px solid rgba(16, 185, 129, 0.3); border-radius: 16px; padding: 24px; margin-bottom: 24px; text-align: center;">
                <i class="bi bi-check-circle" style="font-size: 3rem; color: #10b981; margin-bottom: 12px; display: block;"></i>
                <p style="color: #10b981; font-weight: 600; margin: 0;">Email confirmado com sucesso!</p>
            </div>
            
            <p style="text-align: center; color: var(--c-text-secondary); margin-bottom: 32px;">
                A sua conta está agora ativa. Pode fazer login para começar a explorar o RochaCinema.
            </p>
            
            <a asp-area="Identity" asp-page="/Account/Login" class="btn-primary" style="width: 100%; justify-content: center; text-align: center;">
                <i class="bi bi-box-arrow-in-right" style="font-size: 1.2rem;"></i>
                Fazer Login
            </a>
        }
        else
        {
            <div style="background: rgba(239, 68, 68, 0.1); border: 2px solid rgba(239, 68, 68, 0.3); border-radius: 16px; padding: 24px; margin-bottom: 24px; text-align: center;">
                <i class="bi bi-exclamation-circle" style="font-size: 3rem; color: #ef4444; margin-bottom: 12px; display: block;"></i>
                <p style="color: #ef4444; font-weight: 600; margin: 0;">Erro ao confirmar email</p>
            </div>
            
            <p style="text-align: center; color: var(--c-text-secondary); margin-bottom: 32px;">
                O link de confirmação pode ter expirado ou ser inválido. Por favor, tente registar-se novamente.
            </p>
            
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-primary" style="width: 100%; justify-content: center; text-align: center;">
                <i class="bi bi-person-plus" style="font-size: 1.2rem;"></i>
                Registar Nova Conta
            </a>
        }
        
        <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--c-border); text-align: center;">
            <a asp-area="" asp-controller="Home" asp-action="Index" style="color: var(--c-text-secondary); font-size: 0.95rem; transition: color 0.3s;">
                <i class="bi bi-arrow-left"></i> Voltar ao Início
            </a>
        </div>
    </div>
</div>

<style>
    .identity-layout a:hover {
        color: var(--c-primary) !important;
    }
</style>
