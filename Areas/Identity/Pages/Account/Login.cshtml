@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<style>
    .clean-form-group {
        margin-bottom: 24px;
    }
    
    .form-label-top {
        display: block;
        color: var(--c-text-primary);
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 10px;
        letter-spacing: 0.3px;
    }
    
    .form-input-clean {
        width: 100%;
        background: rgba(11, 11, 11, 0.6);
        border: 2px solid var(--c-border);
        color: var(--c-text-primary);
        padding: 14px 18px;
        border-radius: var(--radius-md);
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: 'Outfit', sans-serif;
    }
    
    .form-input-clean::placeholder {
        color: var(--c-text-muted);
        opacity: 0.6;
    }
    
    .form-input-clean:focus {
        outline: none;
        border-color: var(--c-primary);
        background: rgba(11, 11, 11, 0.8);
        box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.1);
    }
    
    .remember-checkbox {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 24px 0;
    }
    
    .remember-checkbox input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: var(--c-primary);
    }
    
    .remember-checkbox label {
        color: var(--c-text-secondary);
        font-size: 0.95rem;
        cursor: pointer;
        margin: 0;
    }
    
    .login-links {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        margin-top: 24px;
    }
    
    .login-links a {
        color: var(--c-text-secondary);
        font-size: 0.95rem;
        transition: color 0.3s ease;
    }
    
    .login-links a:hover {
        color: var(--c-primary);
    }
    
    .login-links .create-account {
        color: var(--c-text-primary);
        font-weight: 600;
    }
    
    .text-danger {
        color: #ef4444;
        font-size: 0.85rem;
        margin-top: 6px;
        display: block;
    }
</style>

<div class="identity-layout">
    <div class="auth-card" style="animation: fadeInUp 0.6s ease-out;">
        <div class="auth-header">
            <h2>Bem-vindo de volta</h2>
            <p>Entre na sua conta para continuar</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" style="margin-bottom: 20px;"></div>
            
            <!-- Email Field -->
            <div class="clean-form-group">
                <label for="Input_Email" class="form-label-top">Email</label>
                <input asp-for="Input.Email" 
                       class="form-input-clean" 
                       autocomplete="username" 
                       aria-required="true" 
                       placeholder="name@example.com" 
                       id="Input_Email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            
            <!-- Password Field -->
            <div class="clean-form-group">
                <label for="Input_Password" class="form-label-top">Password</label>
                <input asp-for="Input.Password" 
                       type="password"
                       class="form-input-clean" 
                       autocomplete="current-password" 
                       aria-required="true" 
                       placeholder="••••••••" 
                       id="Input_Password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Remember Me -->
            <div class="remember-checkbox">
                <input type="checkbox" asp-for="Input.RememberMe" id="Input_RememberMe" />
                <label for="Input_RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
            </div>

            <!-- Submit Button -->
            <div style="display: flex; justify-content: center; margin-top: 12px;">
                <button id="login-submit" type="submit" class="btn-primary" style="padding: 16px 48px; font-size: 1.1rem; font-weight: 600; font-family: 'Outfit', sans-serif;">
                    Entrar
                </button>
            </div>
            
            
            <!-- Links -->
            <div class="login-links">
                <a id="forgot-password" asp-page="./ForgotPassword">Esqueceu-se da password?</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
