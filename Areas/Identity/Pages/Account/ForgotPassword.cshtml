@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<style>
    .clean-form-group {
        margin-bottom: 24px;
    }
    
    .form-label-top {
        display: block;
        color: var(--c-text-primary);
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 10px;
        letter-spacing: 0.3px;
    }
    
    .form-input-clean {
        width: 100%;
        background: rgba(11, 11, 11, 0.6);
        border: 2px solid var(--c-border);
        color: var(--c-text-primary);
        padding: 14px 18px;
        border-radius: var(--radius-md);
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: 'Outfit', sans-serif;
    }
    
    .form-input-clean::placeholder {
        color: var(--c-text-muted);
        opacity: 0.6;
    }
    
    .form-input-clean:focus {
        outline: none;
        border-color: var(--c-primary);
        background: rgba(11, 11, 11, 0.8);
        box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.1);
    }
    
    .text-danger {
        color: #ef4444;
        font-size: 0.85rem;
        margin-top: 6px;
        display: block;
    }
    
    .info-box {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: var(--radius-md);
        padding: 14px 16px;
        margin-bottom: 20px;
        color: #93c5fd;
        font-size: 0.9rem;
        line-height: 1.5;
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }
    
    .info-box i {
        flex-shrink: 0;
        margin-top: 2px;
        font-size: 1rem;
    }
    
    .back-link {
        text-align: center;
        margin-top: 24px;
    }
    
    .back-link a {
        color: var(--c-text-secondary);
        font-size: 0.95rem;
        transition: color 0.3s ease;
    }
    
    .back-link a:hover {
        color: var(--c-primary);
    }
</style>

<div class="identity-layout">
    <div class="auth-card" style="animation: fadeInUp 0.6s ease-out; max-width: 500px;">
        <div class="auth-header">
            <h2>Esqueceu-se da password?</h2>
            <p>Insira o seu email para recuperar a conta</p>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" style="margin-bottom: 20px;"></div>
            
            <div class="info-box">
                <i class="bi bi-info-circle"></i>
                Enviaremos um link de recuperação para o seu email. Verifique também a pasta de spam.
            </div>
            
            <!-- Email Field -->
            <div class="clean-form-group">
                <label for="Input_Email" class="form-label-top">Email</label>
                <input asp-for="Input.Email" 
                       class="form-input-clean" 
                       autocomplete="username" 
                       aria-required="true" 
                       placeholder="name@example.com" 
                       id="Input_Email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-primary" style="padding: 16px 32px; font-size: 1.1rem; font-weight: 600; margin-top: 12px; font-family: 'Outfit', sans-serif; display: block; margin-left: auto; margin-right: auto;">
                Enviar Link de Recuperação
            </button>
            
            <!-- Back Link -->
            <div class="back-link">
                <a asp-page="./Login">Voltar ao Login</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
