@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<style>
    .clean-form-group {
        margin-bottom: 24px;
    }
    
    .form-label-top {
        display: block;
        color: var(--c-text-primary);
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 10px;
        letter-spacing: 0.3px;
    }
    
    .form-input-clean {
        width: 100%;
        background: rgba(11, 11, 11, 0.6);
        border: 2px solid var(--c-border);
        color: var(--c-text-primary);
        padding: 14px 18px;
        border-radius: var(--radius-md);
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: 'Outfit', sans-serif;
    }
    
    .form-input-clean::placeholder {
        color: var(--c-text-muted);
        opacity: 0.6;
    }
    
    .form-input-clean:focus {
        outline: none;
        border-color: var(--c-primary);
        background: rgba(11, 11, 11, 0.8);
        box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.1);
    }
    
    .text-danger {
        color: #ef4444;
        font-size: 0.85rem;
        margin-top: 6px;
        display: block;
    }
    
    .text-success {
        color: #10b981;
        font-size: 0.95rem;
        padding: 14px 18px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: var(--radius-md);
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .password-requirements {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: var(--radius-md);
        padding: 12px 16px;
        margin-bottom: 24px;
        font-size: 0.85rem;
        color: #93c5fd;
    }
    
    .password-requirements ul {
        margin: 8px 0 0 0;
        padding-left: 20px;
    }
    
    .password-requirements li {
        margin: 4px 0;
    }
</style>

<div class="identity-layout">
    <div class="auth-card" style="animation: fadeInUp 0.6s ease-out;">
        <div class="auth-header">
            <h2>Alterar Password</h2>
            <p>Escolha uma nova password segura</p>
        </div>

        @if (Model.StatusMessage != null)
        {
            <div class="text-success">
                <i class="bi bi-check-circle-fill"></i>
                @Model.StatusMessage
            </div>
        }

        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" style="margin-bottom: 20px;"></div>
            
            <div class="password-requirements">
                <strong>A sua password deve ter:</strong>
                <ul>
                    <li>Mínimo de 6 caracteres</li>
                    <li>Pelo menos um número</li>
                    <li>Pelo menos uma letra minúscula</li>
                </ul>
            </div>
            
            <!-- Old Password -->
            <div class="clean-form-group">
                <label for="Input_OldPassword" class="form-label-top">Password Atual</label>
                <input asp-for="Input.OldPassword" 
                       type="password"
                       class="form-input-clean" 
                       autocomplete="current-password" 
                       aria-required="true" 
                       placeholder="••••••••" 
                       id="Input_OldPassword" />
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>
            
            <!-- New Password -->
            <div class="clean-form-group">
                <label for="Input_NewPassword" class="form-label-top">Nova Password</label>
                <input asp-for="Input.NewPassword" 
                       type="password"
                       class="form-input-clean" 
                       autocomplete="new-password" 
                       aria-required="true" 
                       placeholder="••••••••" 
                       id="Input_NewPassword" />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            
            <!-- Confirm Password -->
            <div class="clean-form-group">
                <label for="Input_ConfirmPassword" class="form-label-top">Confirmar Nova Password</label>
                <input asp-for="Input.ConfirmPassword" 
                       type="password"
                       class="form-input-clean" 
                       autocomplete="new-password" 
                       aria-required="true" 
                       placeholder="••••••••" 
                       id="Input_ConfirmPassword" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-primary w-100" style="padding: 16px 32px; font-size: 1.1rem; font-weight: 600; margin-top: 12px; font-family: 'Outfit', sans-serif;">
                Alterar Password
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
