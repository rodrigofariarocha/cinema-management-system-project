@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
}

<style>
    .clean-form-group {
        margin-bottom: 24px;
    }
    
    .form-label-top {
        display: block;
        color: var(--c-text-primary);
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 10px;
        letter-spacing: 0.3px;
    }
    
    .form-input-clean {
        width: 100%;
        background: rgba(11, 11, 11, 0.6);
        border: 2px solid var(--c-border);
        color: var(--c-text-primary);
        padding: 14px 18px;
        border-radius: var(--radius-md);
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: 'Outfit', sans-serif;
    }
    
    .form-input-clean::placeholder {
        color: var(--c-text-muted);
        opacity: 0.6;
    }
    
    .form-input-clean:focus {
        outline: none;
        border-color: var(--c-primary);
        background: rgba(11, 11, 11, 0.8);
        box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.1);
    }
    
    .form-input-clean[readonly] {
        opacity: 0.6;
        cursor: not-allowed;
        border-color: var(--c-border);
    }
    
    .text-danger {
        color: #ef4444;
        font-size: 0.85rem;
        margin-top: 6px;
        display: block;
    }
    
    .text-success {
        color: #10b981;
        font-size: 0.95rem;
        padding: 14px 18px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: var(--radius-md);
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .info-box {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: var(--radius-md);
        padding: 14px 18px;
        margin-bottom: 24px;
        color: #93c5fd;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .info-text {
        color: var(--c-text-muted);
        font-size: 0.85rem;
        margin-top: 6px;
        display: block;
    }
    
    .email-status {
        padding: 8px 16px;
        border-radius: var(--radius-md);
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
    }
    
    .email-verified {
        background: rgba(16, 185, 129, 0.15);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }
    
    .email-unverified {
        background: rgba(251, 146, 60, 0.15);
        color: #fb923c;
        border: 1px solid rgba(251, 146, 60, 0.3);
    }
</style>

<div class="identity-layout">
    <div class="auth-card" style="animation: fadeInUp 0.6s ease-out;">
        <div class="auth-header">
            <h2>Gerir Email</h2>
            <p>Altere o seu endereço de email</p>
        </div>

        @if (Model.StatusMessage != null)
        {
            <div class="text-success">
                <i class="bi bi-check-circle-fill"></i>
                @Model.StatusMessage
            </div>
        }

        <form id="email-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" style="margin-bottom: 20px;"></div>
            
            @if (Model.IsEmailConfirmed)
            {
                <div class="info-box">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>O seu email está verificado</span>
                </div>
            }
            else
            {
                <div class="info-box" style="background: rgba(251, 146, 60, 0.1); border-color: rgba(251, 146, 60, 0.3); color: #fb923c;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Email não verificado. Por favor verifique o seu email.</span>
                </div>
            }
            
            <!-- Current Email (readonly) -->
            <div class="clean-form-group">
                <label for="Email" class="form-label-top">Email Atual</label>
                <input id="Email" 
                       type="text" 
                       value="@Model.Email" 
                       class="form-input-clean" 
                       readonly />
                @if (Model.IsEmailConfirmed)
                {
                    <span class="email-status email-verified">
                        <i class="bi bi-check-circle-fill"></i>
                        Verificado
                    </span>
                }
                else
                {
                    <span class="email-status email-unverified">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        Não Verificado
                    </span>
                }
            </div>
            
            <!-- New Email -->
            <div class="clean-form-group">
                <label for="Input_NewEmail" class="form-label-top">Novo Email</label>
                <input asp-for="Input.NewEmail" 
                       class="form-input-clean" 
                       autocomplete="email"
                       placeholder="novo-email@example.com" 
                       id="Input_NewEmail" />
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                <span class="info-text">
                    <i class="bi bi-info-circle"></i>
                    Será enviado um email de confirmação para o novo endereço
                </span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-primary w-100" style="padding: 16px 32px; font-size: 1.1rem; font-weight: 600; margin-top: 12px; font-family: 'Outfit', sans-serif;">
                Alterar Email
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
