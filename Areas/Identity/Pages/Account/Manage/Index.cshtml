@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
}

<style>
    .clean-form-group {
        margin-bottom: 24px;
    }
    
    .form-label-top {
        display: block;
        color: var(--c-text-primary);
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 10px;
        letter-spacing: 0.3px;
    }
    
    .form-input-clean {
        width: 100%;
        background: rgba(11, 11, 11, 0.6);
        border: 2px solid var(--c-border);
        color: var(--c-text-primary);
        padding: 14px 18px;
        border-radius: var(--radius-md);
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: 'Outfit', sans-serif;
    }
    
    .form-input-clean::placeholder {
        color: var(--c-text-muted);
        opacity: 0.6;
    }
    
    .form-input-clean:focus {
        outline: none;
        border-color: var(--c-primary);
        background: rgba(11, 11, 11, 0.8);
        box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.1);
    }
    
    .form-input-clean[readonly] {
        opacity: 0.6;
        cursor: not-allowed;
        border-color: var(--c-border);
    }
    
    .text-danger {
        color: #ef4444;
        font-size: 0.85rem;
        margin-top: 6px;
        display: block;
    }
    
    .text-success {
        color: #10b981;
        font-size: 0.95rem;
        padding: 14px 18px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: var(--radius-md);
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .info-text {
        color: var(--c-text-muted);
        font-size: 0.85rem;
        margin-top: 6px;
        display: block;
    }
</style>

<div class="identity-layout">
    <div class="auth-card" style="animation: fadeInUp 0.6s ease-out;">
        <div class="auth-header">
            <h2>Gerir Conta</h2>
            <p>Altere as definições do seu perfil</p>
        </div>

        @if (Model.StatusMessage != null)
        {
            <div class="text-success">
                <i class="bi bi-check-circle-fill"></i>
                @Model.StatusMessage
            </div>
        }

        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" style="margin-bottom: 20px;"></div>
            
            <!-- Username (readonly) -->
            <div class="clean-form-group">
                <label for="Username" class="form-label-top">Email / Username</label>
                <input id="Username" 
                       type="text" 
                       value="@Model.Username" 
                       class="form-input-clean" 
                       readonly />
                <span class="info-text">
                    <i class="bi bi-info-circle"></i>
                    O email não pode ser alterado
                </span>
            </div>
            
            <!-- Phone Number -->
            <div class="clean-form-group">
                <label for="Input_PhoneNumber" class="form-label-top">Número de Telefone</label>
                <input asp-for="Input.PhoneNumber" 
                       class="form-input-clean" 
                       placeholder="Insira o seu número de telefone (opcional)" 
                       id="Input_PhoneNumber" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-primary w-100" style="padding: 16px 32px; font-size: 1.1rem; font-weight: 600; margin-top: 12px; font-family: 'Outfit', sans-serif; display: flex; align-items: center; justify-content: center; gap: 10px;">
                Guardar Alterações
            </button>
            
            <!-- Additional Links -->
            <div style="margin-top: 32px; padding-top: 32px; border-top: 1px solid var(--c-border); display: flex; flex-direction: column; gap: 12px;">
                <a asp-page="./ChangePassword" style="color: var(--c-text-secondary); text-decoration: none; transition: color 0.3s ease; display: flex; align-items: center; gap: 8px;">
                    <i class="bi bi-key"></i>
                    Alterar Password
                </a>
                <a asp-page="./Email" style="color: var(--c-text-secondary); text-decoration: none; transition: color 0.3s ease; display: flex; align-items: center; gap: 8px;">
                    <i class="bi bi-envelope"></i>
                    Gerir Email
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
