@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Forgot password confirmation";
}

<style>
    .confirmation-box {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: var(--radius-lg);
        padding: 40px;
        text-align: center;
        max-width: 500px;
        margin: 80px auto;
    }
    
    .confirmation-icon {
        font-size: 4rem;
        color: #10b981;
        margin-bottom: 24px;
    }
    
    .confirmation-box h2 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 16px;
        color: var(--c-text-primary);
    }
    
    .confirmation-box p {
        color: var(--c-text-secondary);
        font-size: 1.05rem;
        line-height: 1.7;
        margin-bottom: 32px;
    }
</style>

<div class="confirmation-box" style="animation: fadeInUp 0.6s ease-out;">
    <i class="bi bi-check-circle confirmation-icon"></i>
    <h2>Email Enviado!</h2>
    <p>
        Por favor, verifique o seu email para obter instruções sobre como recuperar a sua password.
    </p>
    <p style="font-size: 0.95rem; color: var(--c-text-muted);">
        Não se esqueça de verificar a pasta de spam.
    </p>
    <a asp-page="./Login" class="btn-primary" style="padding: 14px 32px;">
        Voltar ao Login
    </a>
</div>
