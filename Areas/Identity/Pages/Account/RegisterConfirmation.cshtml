@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirme o seu Email";
}

<div class="identity-layout">
    <div class="auth-card" style="max-width: 600px;">
        <div class="auth-header">
            <div style="width: 80px; height: 80px; margin: 0 auto 24px; background: linear-gradient(135deg, #FF3B30, #FF6B5E); border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 40px rgba(255, 59, 48, 0.3); animation: pulse 2s ease-in-out infinite;">
                <i class="bi bi-envelope-paper" style="font-size: 2.5rem; color: white;"></i>
            </div>
            <h2>Verifique o seu Email</h2>
            <p style="margin-top: 16px; color: var(--c-text-secondary);">
                Enviámos um email de confirmação para <strong style="color: var(--c-primary);">@Model.Email</strong>
            </p>
        </div>

        <div style="background: rgba(59, 130, 246, 0.1); border: 2px solid rgba(59, 130, 246, 0.3); border-radius: 16px; padding: 30px; margin-bottom: 32px;">
            <div style="display: flex; gap: 16px; align-items: flex-start;">
                <i class="bi bi-info-circle" style="font-size: 1.5rem; color: #3b82f6; flex-shrink: 0; margin-top: 4px;"></i>
                <div>
                    <h3 style="margin: 0 0 12px; color: #3b82f6; font-size: 1.1rem; font-weight: 700;">
                        Próximos Passos
                    </h3>
                    <ol style="margin: 0; padding-left: 20px; color: var(--c-text-secondary); line-height: 1.8;">
                        <li>Abra o seu email e procure por uma mensagem da <strong>RochaCinema</strong></li>
                        <li>Clique no botão vermelho <strong>"Confirmar Email"</strong> no email</li>
                        <li>Será redirecionado para a página de confirmação</li>
                        <li>Após confirmar, pode fazer login e começar a usar a plataforma!</li>
                    </ol>
                </div>
            </div>
        </div>

        <div style="background: rgba(255, 255, 255, 0.03); border-radius: 12px; padding: 20px; margin-bottom: 24px;">
            <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 12px;">
                <i class="bi bi-exclamation-triangle" style="color: #f59e0b;"></i>
                <p style="margin: 0; color: var(--c-text-secondary); font-size: 0.95rem;">
                    <strong style="color: var(--c-text-primary);">Não recebeu o email?</strong>
                </p>
            </div>
            <ul style="margin: 0; padding-left: 20px; color: var(--c-text-muted); font-size: 0.9rem; line-height: 1.7;">
                <li>Verifique a pasta de spam ou lixo eletrónico</li>
                <li>Aguarde alguns minutos - pode demorar um pouco</li>
                <li>Certifique-se que o endereço de email está correto</li>
            </ul>
        </div>

        @if (Model.DisplayConfirmAccountLink)
        {
            <div style="text-align: center; padding: 24px; background: rgba(239, 68, 68, 0.1); border: 2px solid rgba(239, 68, 68, 0.3); border-radius: 12px; margin-bottom: 24px;">
                <p style="margin: 0 0 16px; color: #ef4444; font-weight: 600;">
                    <i class="bi bi-tools"></i> Modo de Desenvolvimento
                </p>
                <p style="margin: 0 0 16px; color: var(--c-text-secondary); font-size: 0.9rem;">
                    Para fins de teste, pode confirmar a conta diretamente:
                </p>
                <a href="@Model.EmailConfirmationUrl" class="btn-outline" style="display: inline-flex;">
                    <i class="bi bi-check-circle"></i>
                    Confirmar Conta
                </a>
            </div>
        }

        <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--c-border); text-align: center;">
            <a asp-area="" asp-controller="Home" asp-action="Index" style="color: var(--c-text-secondary); font-size: 0.95rem; transition: color 0.3s;">
                <i class="bi bi-arrow-left"></i> Voltar ao Início
            </a>
        </div>
    </div>
</div>

<style>
    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            box-shadow: 0 10px 40px rgba(255, 59, 48, 0.3);
        }
        50% {
            transform: scale(1.05);
            box-shadow: 0 15px 50px rgba(255, 59, 48, 0.5);
        }
    }

    .identity-layout a:hover {
        color: var(--c-primary) !important;
    }
</style>
