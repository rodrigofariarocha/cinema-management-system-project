<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RochaCinema</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">RochaCinema</a>
                <ul class="navbar-nav">
                    <li>
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Filmes</a>
                    </li>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a class="nav-link" asp-controller="Movies" asp-action="Index">Gestão Filmes</a>
                            </li>
                            <li>
                                <a class="nav-link" asp-controller="Theaters" asp-action="Index">Gestão Salas</a>
                            </li>
                            <li>
                                <a class="nav-link" asp-controller="Screenings" asp-action="Index">Gestão Sessões</a>
                            </li>
                            <li>
                                <a class="nav-link" asp-controller="AdminTickets" asp-action="Index">Gestão Bilhetes</a>
                            </li>
                        }
                        
                        <li>
                            <a class="nav-link" asp-controller="Tickets" asp-action="MyTickets">Meus Bilhetes</a>
                        </li>
                        
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline;">
                                <button type="submit" class="btn btn-sm btn-secondary" title="@User.Identity.Name">Sair (@(User.Identity.Name?.Split("@")[0]))</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Entrar</a>
                        </li>
                        <li>
                            <a class="btn btn-sm btn-secondary" asp-controller="Account" asp-action="Register">Registar</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="py-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }
            
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }
            
            @RenderBody()
        </main>
    </div>

    <footer style="border-top: 1px solid hsl(var(--border)); margin-top: 4rem; padding: 2rem 0; text-align: center; color: hsl(var(--muted-foreground));">
        <div class="container">
            &copy; 2025 - RochaCinema - Sistema de Gestão de Cinema
        </div>
    </footer>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
