<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rocha Cinema</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="icon" type="image/png" href="/img/logo.png">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
</head>
<body>
    <header>
        <div class="nav-container">
            <a class="logo" asp-controller="Home" asp-action="Index">
                ROCHA<span>CINEMA</span>
            </a>
            
            <nav class="nav-links">
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
                   asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="now-showing">Filmes</a>
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="nav-link" asp-controller="Loyalty" asp-action="Index">Pontos e Ofertas</a>
                    <a class="nav-link" asp-controller="Tickets" asp-action="MyTickets">Meus Bilhetes</a>
                }
                @if (User.Identity.IsAuthenticated && User.Identity.Name == "admin@rochacinema.com")
                {
                    <a class="nav-link text-danger" asp-controller="Admin" asp-action="Index">Admin</a>
                }
            </nav>

            <div class="nav-actions">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()

    <!-- Trailer Modal -->
    <div id="trailerModal" class="trailer-modal" onclick="closeTrailerModal(event)">
        <div class="trailer-modal-content">
            <button class="trailer-close-btn" onclick="closeTrailerModal(event)">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="trailer-wrapper">
                <iframe id="trailerIframe" 
                        src="" 
                        frameborder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen>
                </iframe>
            </div>
        </div>
    </div>

    <style>
        .trailer-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 10000;
            animation: fadeIn 0.3s ease-out;
            backdrop-filter: blur(10px);
        }

        .trailer-modal.active {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .trailer-modal-content {
            position: relative;
            width: 100%;
            max-width: 1200px;
            animation: slideInUp 0.4s ease-out;
        }

        .trailer-close-btn {
            position: absolute;
            top: -50px;
            right: 0;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            color: white;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 1.2rem;
            backdrop-filter: blur(10px);
        }

        .trailer-close-btn:hover {
            background: var(--c-primary);
            border-color: var(--c-primary);
            transform: rotate(90deg);
        }

        .trailer-wrapper {
            position: relative;
            width: 100%;
            padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
            background: #000;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 20px 80px rgba(0, 0, 0, 0.8);
        }

        .trailer-wrapper iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        @@keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .trailer-close-btn {
                top: -40px;
                width: 38px;
                height: 38px;
                font-size: 1rem;
            }
        }
    </style>

    <script>
        function openTrailerModal(trailerUrl) {
            const modal = document.getElementById('trailerModal');
            const iframe = document.getElementById('trailerIframe');
            
            // Convert YouTube URL to embed format
            let embedUrl = trailerUrl;
            if (trailerUrl.includes('youtube.com/watch?v=')) {
                const videoId = trailerUrl.split('v=')[1].split('&')[0];
                embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
            } else if (trailerUrl.includes('youtu.be/')) {
                const videoId = trailerUrl.split('youtu.be/')[1].split('?')[0];
                embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
            }
            
            iframe.src = embedUrl;
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeTrailerModal(event) {
            if (event.target.id === 'trailerModal' || event.target.closest('.trailer-close-btn')) {
                const modal = document.getElementById('trailerModal');
                const iframe = document.getElementById('trailerIframe');
                
                modal.classList.remove('active');
                iframe.src = '';
                document.body.style.overflow = 'auto';
            }
        }

        // Close modal on ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const modal = document.getElementById('trailerModal');
                if (modal.classList.contains('active')) {
                    closeTrailerModal({ target: modal });
                }
            }
        });
    </script>
    </main>

    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <div class="logo">
                        ROCHA<span>CINEMA</span>
                    </div>
                    <p>A melhor experiência de cinema. Salas premium, som imersivo e os últimos lançamentos.</p>
                    <div class="social-links">
                        <a href="#" class="social-link" title="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="#" class="social-link" title="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="#" class="social-link" title="Twitter">
                            <i class="bi bi-twitter-x"></i>
                        </a>
                        <a href="#" class="social-link" title="YouTube">
                            <i class="bi bi-youtube"></i>
                        </a>
                    </div>
                </div>
                <div class="footer-col">
                    <h4>Filmes</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="now-showing">Em Exibição</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Suporte</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Contact">Contactos</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Política de Privacidade</a></li>
                    </ul>
                </div>
            </div>
            <div class="copyright">
                &copy; 2025 Rocha Cinema. Todos os direitos reservados.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // User dropdown toggle
        (function() {
            const userButton = document.getElementById('userMenuButton');
            const dropdown = document.getElementById('userDropdown');
            const chevron = document.getElementById('chevronIcon');
            
            if (userButton && dropdown) {
                userButton.addEventListener('click', function(e) {
                    e.stopPropagation();
                    e.preventDefault();
                    
                    const isOpen = dropdown.classList.contains('show');
                    
                    if (isOpen) {
                        dropdown.classList.remove('show');
                        if (chevron) chevron.style.transform = 'rotate(0deg)';
                    } else {
                        dropdown.classList.add('show');
                        if (chevron) chevron.style.transform = 'rotate(180deg)';
                    }
                });
                
                document.addEventListener('click', function(e) {
                    if (!userButton.contains(e.target) && !dropdown.contains(e.target)) {
                        dropdown.classList.remove('show');
                        if (chevron) chevron.style.transform = 'rotate(0deg)';
                    }
                });
            }
        })();
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
