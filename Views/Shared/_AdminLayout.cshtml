<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RochaCinema Admin</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        .admin-container {
            display: flex;
            min-height: 100vh;
        }

        .admin-sidebar {
            width: 280px;
            background-color: var(--c-bg-surface);
            border-right: 1px solid var(--c-border);
            padding: 24px;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
        }

        .admin-content {
            flex: 1;
            margin-left: 280px;
            padding: 40px;
            background-color: var(--c-bg-main);
        }

        .sidebar-brand {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--c-text-primary);
            margin-bottom: 40px;
            display: block;
            text-decoration: none;
        }

        .sidebar-brand span { color: var(--c-primary); }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav-item-admin {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: var(--c-text-secondary);
            border-radius: var(--radius-md);
            transition: all 0.2s;
            text-decoration: none;
            font-weight: 500;
        }

        .nav-item-admin:hover, .nav-item-admin.active {
            background-color: rgba(255, 59, 48, 0.1);
            color: var(--c-primary);
        }

        .nav-item-admin i { font-size: 1.2rem; }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }

        .stat-card {
            background: var(--c-bg-surface);
            border: 1px solid var(--c-border);
            border-radius: var(--radius-md);
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: rgba(255, 59, 48, 0.1);
            color: var(--c-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .stat-info h3 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
            line-height: 1;
        }

        .stat-info p {
            color: var(--c-text-secondary);
            margin: 4px 0 0;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <a href="/" class="sidebar-brand">ROCHA<span>ADMIN</span></a>
            
            <nav class="sidebar-nav">
                <a asp-controller="Admin" asp-action="Index" class="nav-item-admin @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-grid-fill"></i> Dashboard
                </a>
                <a asp-controller="Admin" asp-action="Movies" class="nav-item-admin @(ViewContext.RouteData.Values["Action"]?.ToString() == "Movies" ? "active" : "")">
                    <i class="bi bi-film"></i> Filmes
                </a>
                <a asp-controller="Admin" asp-action="Sessions" class="nav-item-admin @(ViewContext.RouteData.Values["Action"]?.ToString() == "Sessions" ? "active" : "")">
                    <i class="bi bi-calendar-event"></i> Sessões
                </a>
                <a asp-controller="Admin" asp-action="Rooms" class="nav-item-admin @(ViewContext.RouteData.Values["Action"]?.ToString() == "Rooms" ? "active" : "")">
                    <i class="bi bi-door-open"></i> Salas
                </a>
            </nav>

            <div style="margin-top: auto;">
                <a href="/" class="nav-item-admin">
                    <i class="bi bi-box-arrow-left"></i> Voltar ao Site
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
