@model CinemaRocha.Models.Session

@{
    ViewData["Title"] = "Nova Sessão";
    Layout = "_AdminLayout";
}

<div class="admin-header">
    <div>
        <h1 class="h2 fw-bold">Nova Sessão</h1>
        <p class="text-muted">Agendar uma nova sessão</p>
    </div>
    <a asp-action="Sessions" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="CreateSession">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="MovieId" class="form-label">Filme</label>
                        <select asp-for="MovieId" class="form-select bg-dark text-white border-secondary" asp-items="ViewBag.MovieId"></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RoomId" class="form-label">Sala</label>
                        <select asp-for="RoomId" class="form-select bg-dark text-white border-secondary" asp-items="ViewBag.RoomId"></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StartTime" class="form-label">Data e Hora</label>
                        <input asp-for="StartTime" class="form-control bg-dark text-white border-secondary" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Price" class="form-label">Preço (€)</label>
                        <input asp-for="Price" class="form-control bg-dark text-white border-secondary" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Sessions" class="btn btn-outline-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Agendar Sessão</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
