@model CinemaRocha.Models.Movie

@{
    ViewData["Title"] = "Novo Filme";
    Layout = "_AdminLayout";
}

<style>
    /* TMDB Search Section */
    .tmdb-search-section {
        background: var(--glass-bg);
        backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-lg);
        padding: 32px;
        margin-bottom: 32px;
        animation: fadeInUp 0.6s ease-out;
    }

    .search-header {
        margin-bottom: 24px;
    }

    .search-header h3 {
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .search-header p {
        color: var(--c-text-secondary);
        margin: 0;
    }

    .search-box {
        position: relative;
        margin-bottom: 24px;
    }

    .search-input {
        width: 100%;
        padding: 16px 50px 16px 20px;
        background: rgba(11, 11, 11, 0.6);
        border: 2px solid var(--c-border);
        border-radius: var(--radius-md);
        color: var(--c-text-primary);
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: 'Outfit', sans-serif;
    }

    .search-input:focus {
        outline: none;
        border-color: var(--c-primary);
        box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.1);
    }

    .search-icon {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--c-text-muted);
        font-size: 1.2rem;
    }

    .search-results {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 16px;
        max-height: 500px;
        overflow-y: auto;
        margin-right: -12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-left: 8px;
    }

    .movie-result-card {
        background: rgba(22, 22, 22, 0.6);
        border: 1px solid var(--c-border);
        border-radius: var(--radius-md);
        overflow: hidden;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        display: flex;
        flex-direction: column;
        max-width: 200px;
        justify-self: start;
    }

    .movie-result-card:hover {
        transform: translateY(-4px) scale(1.02);
        border-color: var(--c-primary);
        box-shadow: 0 12px 32px rgba(239, 68, 68, 0.3);
    }

    .tmdb-poster-container {
        width: 100%;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        background: linear-gradient(135deg, #1a1a1a 0%, #252525 100%);
        position: relative;
    }

    .movie-poster-tmdb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .movie-poster-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #1a1a1a 0%, #252525 100%);
        color: var(--c-text-muted);
        font-size: 2rem;
        opacity: 0.3;
    }

    .movie-info-tmdb {
        padding: 10px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .movie-title-tmdb {
        font-weight: 600;
        font-size: 0.813rem;
        margin-bottom: 4px;
        color: var(--c-text-primary);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.3;
        min-height: 2.1em;
    }

    .movie-year-tmdb {
        font-size: 0.75rem;
        color: var(--c-text-secondary);
        opacity: 0.7;
    }

    .movie-rating-tmdb {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(11, 11, 11, 0.95);
        padding: 3px 7px;
        border-radius: var(--radius-sm);
        font-size: 0.688rem;
        font-weight: 700;
        color: #fbbf24;
        display: flex;
        align-items: center;
        gap: 2px;
    }

    /* Form Section */
    .form-section {
        background: var(--glass-bg);
        backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-lg);
        padding: 32px;
        animation: fadeInUp 0.6s ease-out 0.2s both;
    }

    .form-section h3 {
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 24px;
    }

    .form-group-clean {
        margin-bottom: 24px;
    }

    .form-label-clean {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--c-text-primary);
        font-size: 0.95rem;
    }

    .form-input-admin {
        width: 100%;
        padding: 14px 18px;
        background: rgba(11, 11, 11, 0.6);
        border: 2px solid var(--c-border);
        border-radius: var(--radius-md);
        color: var(--c-text-primary);
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: 'Outfit', sans-serif;
    }

    .form-input-admin:focus {
        outline: none;
        border-color: var(--c-primary);
        box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.1);
    }

    textarea.form-input-admin {
        min-height: 120px;
        resize: vertical;
    }

    .poster-preview {
        background: rgba(22, 22, 22, 0.6);
        border: 1px solid var(--c-border);
        border-radius: var(--radius-md);
        padding: 20px;
        text-align: center;
    }

    .poster-preview img {
        max-width: 100%;
        max-height: 400px;
        border-radius: var(--radius-md);
    }

    .loading-spinner {
        text-align: center;
        padding: 40px;
        color: var(--c-text-secondary);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: var(--c-text-muted);
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 16px;
        opacity: 0.5;
    }
</style>

<div class="admin-header">
    <div>
        <h1 class="h2 fw-bold">Novo Filme</h1>
        <p class="text-muted">Pesquisar na base de dados TMDB ou criar manualmente</p>
    </div>
    <a asp-action="Movies" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<!-- TMDB Search Section -->
<div class="tmdb-search-section">
    <div class="search-header">
        <h3><i class="bi bi-search"></i> Pesquisar Filmes TMDB</h3>
        <p>Pesquise filmes na base de dados do TMDB para preencher automaticamente</p>
    </div>

    <div class="search-box">
        <input type="text" 
               id="tmdbSearch" 
               class="search-input" 
               placeholder="Pesquisar filmes (ex: Inception, Avatar, Matrix...)"
               autocomplete="off">
        <i class="bi bi-search search-icon"></i>
    </div>

    <div id="searchResults"></div>
</div>

<!-- Form Section -->
<div class="row">
    <div class="col-12">
        <div class="form-section">
            <h3><i class="bi bi-film"></i> Informações do Filme</h3>
            
            <form id="movieForm" asp-action="CreateMovie" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="form-group-clean">
                    <label class="form-label-clean">Título</label>
                    <input asp-for="Title" id="movieTitle" class="form-input-admin" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group-clean">
                        <label class="form-label-clean">Género</label>
                        <input asp-for="Genre" id="movieGenre" class="form-input-admin" />
                        <span asp-validation-for="Genre" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 form-group-clean">
                        <label class="form-label-clean">Duração (minutos)</label>
                        <input asp-for="Duration" id="movieDuration" type="number" class="form-input-admin" />
                        <span asp-validation-for="Duration" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 form-group-clean">
                        <label class="form-label-clean">Avaliação IMDb</label>
                        <input asp-for="ImdbRating" id="movieImdbRating" class="form-input-admin" placeholder="ex: 8.5" />
                        <span asp-validation-for="ImdbRating" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group-clean">
                    <label class="form-label-clean">URL da Imagem (Poster)</label>
                    <input asp-for="ImageUrl" id="movieImageUrl" class="form-input-admin" />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                </div>

                <div class="form-group-clean">
                    <label class="form-label-clean">URL do Trailer (YouTube)</label>
                    <input asp-for="TrailerUrl" id="movieTrailerUrl" class="form-input-admin" placeholder="https://www.youtube.com/watch?v=..." />
                    <span asp-validation-for="TrailerUrl" class="text-danger"></span>
                </div>

                <div class="form-group-clean">
                    <label class="form-label-clean">Sinopse</label>
                    <textarea asp-for="Description" id="movieDescription" class="form-input-admin"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </form>
            
            <div style="margin-top: 32px; display: flex; justify-content: space-between; align-items: center;">
                <a asp-action="Movies" class="btn btn-outline-light" style="padding: 14px 32px;">Cancelar</a>
                <button type="submit" form="movieForm" class="btn-primary" style="padding: 14px 32px; border: none; border-radius: var(--radius-md); font-family: 'Outfit', sans-serif; font-weight: 600;">
                    Guardar Filme
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let searchTimeout;
        const searchInput = document.getElementById('tmdbSearch');
        const searchResults = document.getElementById('searchResults');

        // TMDB Search
        searchInput.addEventListener('input', function() {
            const query = this.value.trim();
            
            clearTimeout(searchTimeout);
            
            if (query.length < 2) {
                searchResults.innerHTML = '';
                return;
            }

            searchResults.innerHTML = '<div class="loading-spinner"><i class="bi bi-hourglass-split"></i> A pesquisar...</div>';

            searchTimeout = setTimeout(async () => {
                try {
                    console.log('Searching for:', query);
                    const response = await fetch(`/Admin/SearchTmdb?query=${encodeURIComponent(query)}`);
                    console.log('Response status:', response.status);
                    
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    
                    const movies = await response.json();
                    console.log('Movies found:', movies);

                    if (movies.length === 0) {
                        searchResults.innerHTML = '<div class="empty-state"><i class="bi bi-film"></i><p>Nenhum filme encontrado</p></div>';
                        return;
                    }

                    let html = '<div class="search-results">';
                    movies.forEach(movie => {
                        const year = movie.releaseDate ? new Date(movie.releaseDate).getFullYear() : 'N/A';
                        const rating = movie.voteAverage ? movie.voteAverage.toFixed(1) : 'N/A';
                        const hasImage = movie.posterPath && !movie.posterPath.includes('null');
                        
                        html += `
                            <div class="movie-result-card" onclick="selectTmdbMovie(${movie.id})">
                                <div class="movie-rating-tmdb">
                                    <i class="bi bi-star-fill"></i> ${rating}
                                </div>
                                <div class="tmdb-poster-container">
                                    ${hasImage 
                                        ? `<img src="${movie.posterPath}" 
                                               alt="${movie.title}" 
                                               class="movie-poster-tmdb"
                                               onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                           <div class="movie-poster-placeholder" style="display: none;">
                                               <i class="bi bi-film"></i>
                                           </div>` 
                                        : `<div class="movie-poster-placeholder">
                                            <i class="bi bi-film"></i>
                                           </div>`
                                    }
                                </div>
                                <div class="movie-info-tmdb">
                                    <div class="movie-title-tmdb">${movie.title}</div>
                                    <div class="movie-year-tmdb">${year}</div>
                                </div>
                            </div>
                        `;
                    });
                    html += '</div>';
                    searchResults.innerHTML = html;
                } catch (error) {
                    console.error('Search error:', error);
                    searchResults.innerHTML = '<div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p>Erro ao pesquisar: ' + error.message + '</p></div>';
                }
            }, 500);
        });

        // Select TMDB Movie
        window.selectTmdbMovie = async function(tmdbId) {
            try {
                console.log('Loading movie:', tmdbId);
                const response = await fetch(`/Admin/GetTmdbMovie?id=${tmdbId}`);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const movie = await response.json();
                console.log('Movie data:', movie);

                // Fill form fields
                document.getElementById('movieTitle').value = movie.title;
                document.getElementById('movieDescription').value = movie.description;
                document.getElementById('movieGenre').value = movie.genre;
                document.getElementById('movieDuration').value = movie.duration;
                document.getElementById('movieImageUrl').value = movie.imageUrl;
                
                // Populate ImdbRating
                if (movie.imdbRating) {
                    document.getElementById('movieImdbRating').value = movie.imdbRating;
                }
                
                // Populate LogoUrl if field exists
                const logoUrlField = document.getElementById('movieLogoUrl');
                if (logoUrlField && movie.logoUrl) {
                    logoUrlField.value = movie.logoUrl;
                }

                // Clear search
                searchInput.value = '';
                searchResults.innerHTML = '';

                // Scroll to form
                document.querySelector('.form-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
            } catch (error) {
                console.error('Error loading movie:', error);
                alert('Erro ao carregar detalhes do filme: ' + error.message);
            }
        };
    </script>
}
