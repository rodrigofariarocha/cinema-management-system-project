@model IEnumerable<CinemaRocha.Models.Session>

@{
    ViewData["Title"] = "Gestão de Sessões";
    Layout = "_AdminLayout";
}

<div class="admin-header">
    <div>
        <h1 class="h2 fw-bold">Sessões</h1>
        <p class="text-muted">Agendar e gerir sessões</p>
    </div>
    <a asp-action="CreateSession" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nova Sessão
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Data/Hora</th>
                        <th>Filme</th>
                        <th>Sala</th>
                        <th>Preço</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderBy(s => s.StartTime))
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@item.StartTime.ToString("dd/MM/yyyy")</div>
                                <div class="small text-muted">@item.StartTime.ToString("HH:mm")</div>
                            </td>
                            <td>@item.Movie?.Title</td>
                            <td>@item.Room?.Name</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="EditSession" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="DeleteSession" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
