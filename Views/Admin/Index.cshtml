@model CinemaRocha.Controllers.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<style>
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    .dashboard-header h1 {
        font-family: 'Outfit', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
        color: var(--c-text);
    }

    .dashboard-header p {
        color: var(--c-text-muted);
        margin: 4px 0 0 0;
        font-size: 0.938rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 24px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-lg);
        padding: 28px 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
    }

    .stat-icon {
        width: 64px;
        height: 64px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        flex-shrink: 0;
    }

    .stat-icon-red {
        background: rgba(239, 68, 68, 0.15);
        color: var(--c-primary);
    }

    .stat-icon-blue {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
    }

    .stat-icon-green {
        background: rgba(16, 185, 129, 0.15);
        color: #10b981;
    }

    .stat-icon-orange {
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
    }

    .stat-info {
        flex: 1;
    }

    .stat-value {
        font-family: 'Outfit', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--c-text);
        margin: 0 0 4px 0;
        line-height: 1;
    }

    .stat-label {
        font-size: 0.875rem;
        color: var(--c-text-muted);
        font-weight: 500;
        margin: 0;
    }

    .activity-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-lg);
        overflow: visible;
        position: relative;
    }

    .activity-header {
        padding: 24px 28px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .activity-header h5 {
        font-family: 'Outfit', sans-serif;
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--c-text);
        margin: 0;
    }

    .activity-body {
        padding: 0;
    }

    .activity-item {
        padding: 16px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: flex-start;
        gap: 16px;
        transition: background 0.2s ease;
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-item:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .activity-icon {
        width: 36px;
        height: 36px;
        background: rgba(239, 68, 68, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .activity-icon i {
        font-size: 1rem;
        color: var(--c-primary);
    }

    .activity-content {
        flex: 1;
        min-width: 0;
    }

    .activity-text {
        color: var(--c-text-muted);
        font-size: 0.875rem;
        line-height: 1.5;
        margin-bottom: 4px;
    }

    .activity-text strong {
        color: var(--c-text);
        font-weight: 600;
    }

    .activity-time {
        font-size: 0.75rem;
        color: var(--c-text-muted);
        opacity: 0.6;
    }

    .activity-icon-green {
        background: rgba(52, 211, 153, 0.1) !important;
    }

    .activity-icon-green i {
        color: #34d399 !important;
    }

    .activity-icon-orange {
        background: rgba(251, 146, 60, 0.1) !important;
    }

    .activity-icon-orange i {
        color: #fb923c !important;
    }

    .activity-icon-blue {
        background: rgba(96, 165, 250, 0.1) !important;
    }

    .activity-icon-blue i {
        color: #60a5fa !important;
    }

    .btn-activity-filter {
        padding: 10px 20px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--c-text);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.25s ease;
        font-family: 'Outfit', sans-serif;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-activity-filter:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateY(-2px);
    }

    .btn-activity-filter i {
        font-size: 0.75rem;
        transition: transform 0.3s ease;
    }

    .dropdown-actions.active .btn-activity-filter i {
        transform: rotate(180deg);
    }

    .empty-activity {
        padding: 60px 28px;
        text-align: center;
    }

    .empty-activity i {
        font-size: 3.5rem;
        opacity: 0.15;
        color: var(--c-text-muted);
        margin-bottom: 20px;
        display: block;
    }

    .empty-activity p {
        color: var(--c-text-muted);
        font-size: 0.938rem;
        margin: 0;
    }

    .btn-view-all {
        padding: 8px 20px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--c-text);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-view-all:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateY(-2px);
        color: var(--c-text);
    }

    .btn-new-movie {
        padding: 13px 26px;
        background: var(--c-primary);
        color: white;
        border: none;
        border-radius: var(--radius-md);
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.25s ease;
        font-size: 0.938rem;
    }

    .btn-new-movie:hover {
        background: #dc2626;
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(239, 68, 68, 0.35);
        color: white;
    }

    .dashboard-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    .btn-dashboard {
        padding: 11px 20px;
        border-radius: var(--radius-md);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.25s ease;
        font-size: 0.875rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-dashboard i {
        font-size: 1rem;
    }

    .btn-export {
        background: rgba(59, 130, 246, 0.1);
        color: #60a5fa;
    }

    .btn-export:hover {
        background: rgba(59, 130, 246, 0.25);
        border-color: rgba(59, 130, 246, 0.6);
        transform: translateY(-2px);
        color: #60a5fa;
    }

    .btn-reservations {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
    }

    .btn-reservations:hover {
        background: rgba(16, 185, 129, 0.25);
        border-color: rgba(16, 185, 129, 0.6);
        transform: translateY(-2px);
        color: #10b981;
    }

    .btn-refresh {
        background: rgba(255, 255, 255, 0.05);
        color: var(--c-text);
        padding: 11px 14px;
    }

    .btn-refresh:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateY(-2px);
        color: var(--c-text);
    }

    .dropdown-actions {
        position: relative;
    }

    .btn-quick-actions {
        background: var(--c-primary);
        color: white;
        border-color: var(--c-primary);
        font-family: 'Outfit', sans-serif;
    }

    .btn-quick-actions:hover {
        background: #dc2626;
        border-color: #dc2626;
        transform: translateY(-2px);
        color: white;
    }

    .dropdown-menu-actions {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        background: rgba(20, 20, 20, 0.98);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-md);
        min-width: 200px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.25s ease;
        z-index: 1000;
        padding: 8px;
    }

    .dropdown-actions:hover .dropdown-menu-actions {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .dropdown-item-action {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        color: var(--c-text);
        text-decoration: none;
        border-radius: var(--radius-sm);
        transition: all 0.2s ease;
        font-size: 0.875rem;
    }

    .dropdown-item-action i {
        font-size: 1.125rem;
        width: 20px;
        text-align: center;
    }

    .dropdown-item-action:hover {
        background: rgba(255, 255, 255, 0.1);
        color: var(--c-text);
    }

    .dropdown-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.1);
        margin: 8px 0;
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .dashboard-actions {
            width: 100%;
        }

        .btn-dashboard {
            flex: 1;
            justify-content: center;
        }

        .stat-card {
            padding: 20px;
        }

        .stat-icon {
            width: 56px;
            height: 56px;
            font-size: 1.5rem;
        }

        .stat-value {
            font-size: 1.75rem;
        }
    }
</style>

<div class="dashboard-header">
    <div>
        <h1>Dashboard</h1>
        <p>Visão geral do cinema</p>
    </div>
    <div class="dashboard-actions">
        <a asp-action="ExportReport" class="btn-dashboard btn-export">
            <i class="bi bi-download"></i> Exportar
        </a>
        <a href="/Admin/Reservations" class="btn-dashboard btn-reservations">
            <i class="bi bi-ticket-perforated"></i> Reservas
        </a>
        <button class="btn-dashboard btn-refresh" onclick="location.reload();" title="Atualizar dados">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
        <div class="dropdown-actions">
            <button class="btn-dashboard btn-quick-actions">
                Ações Rápidas
            </button>
            <div class="dropdown-menu-actions">
                <a asp-action="CreateMovie" class="dropdown-item-action">
                    <i class="bi bi-film"></i>
                    <span>Novo Filme</span>
                </a>
                <a asp-action="CreateSession" class="dropdown-item-action">
                    <i class="bi bi-calendar-plus"></i>
                    <span>Nova Sessão</span>
                </a>
                <a asp-action="CreateRoom" class="dropdown-item-action">
                    <i class="bi bi-door-open"></i>
                    <span>Nova Sala</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Stats Grid -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon stat-icon-red">
            <i class="bi bi-currency-euro"></i>
        </div>
        <div class="stat-info">
            <h3 class="stat-value">@Model.TotalRevenue.ToString("N2")€</h3>
            <p class="stat-label">Receita Total</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon-blue">
            <i class="bi bi-ticket-perforated"></i>
        </div>
        <div class="stat-info">
            <h3 class="stat-value">@Model.TotalReservations</h3>
            <p class="stat-label">Bilhetes Vendidos</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon-green">
            <i class="bi bi-film"></i>
        </div>
        <div class="stat-info">
            <h3 class="stat-value">@Model.TotalMovies</h3>
            <p class="stat-label">Filmes Ativos</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon-orange">
            <i class="bi bi-calendar-event"></i>
        </div>
        <div class="stat-info">
            <h3 class="stat-value">@Model.TotalSessions</h3>
            <p class="stat-label">Sessões Agendadas</p>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="activity-card">
    <div class="activity-header">
        <h5>Atividade Recente</h5>
        <div class="dropdown-actions">
            <button class="btn-dashboard btn-activity-filter" id="activityFilterBtn">
                <span id="activityFilterText">Reservas</span>
                <i class="bi bi-chevron-down"></i>
            </button>
            <div class="dropdown-menu-actions" id="activityFilterMenu">
                <a href="#" class="dropdown-item-action" data-filter="reservations">
                    <i class="bi bi-ticket-perforated"></i>
                    <span>Reservas</span>
                </a>
                <a href="#" class="dropdown-item-action" data-filter="movies">
                    <i class="bi bi-film"></i>
                    <span>Filmes</span>
                </a>
                <a href="#" class="dropdown-item-action" data-filter="sessions">
                    <i class="bi bi-calendar-event"></i>
                    <span>Sessões</span>
                </a>
                <a href="#" class="dropdown-item-action" data-filter="rooms">
                    <i class="bi bi-door-open"></i>
                    <span>Salas</span>
                </a>
            </div>
        </div>
    </div>
    <div class="activity-body">
        <!-- Reservations -->
        <div class="activity-list" data-type="reservations">
            @if (Model.RecentReservations != null && Model.RecentReservations.Any())
            {
                @foreach (var reservation in Model.RecentReservations)
                {
                    <div class="activity-item">
                        <div class="activity-icon">
                            <i class="bi bi-ticket-perforated"></i>
                        </div>
                        <div class="activity-content">
                            <div class="activity-text">
                                <strong>@(reservation.User?.Email?.Split('@')[0] ?? "Cliente")</strong> reservou 
                                <strong>@reservation.Seats.Count lugar(es)</strong> para
                                <strong>@reservation.Session?.Movie?.Title</strong>
                            </div>
                            <div class="activity-time">
                                @{
                                    var timeSpan = DateTime.Now - reservation.ReservationDate;
                                    var timeAgo = timeSpan.TotalMinutes < 60 
                                        ? $"{(int)timeSpan.TotalMinutes}m atrás" 
                                        : timeSpan.TotalHours < 24 
                                            ? $"{(int)timeSpan.TotalHours}h atrás" 
                                            : $"{(int)timeSpan.TotalDays}d atrás";
                                }
                                @timeAgo
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-activity">
                    <i class="bi bi-ticket-perforated"></i>
                    <p>Ainda não há reservas recentes.</p>
                </div>
            }
        </div>

        <!-- Movies -->
        <div class="activity-list" data-type="movies" style="display: none;">
            @if (Model.RecentMovies != null && Model.RecentMovies.Any())
            {
                @foreach (var movie in Model.RecentMovies)
                {
                    <div class="activity-item">
                        <div class="activity-icon activity-icon-green">
                            <i class="bi bi-film"></i>
                        </div>
                        <div class="activity-content">
                            <div class="activity-text">
                                Filme <strong>@movie.Title</strong> foi adicionado
                            </div>
                            <div class="activity-time">
                                @movie.Genre
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-activity">
                    <i class="bi bi-film"></i>
                    <p>Ainda não há filmes adicionados.</p>
                </div>
            }
        </div>

        <!-- Sessions -->
        <div class="activity-list" data-type="sessions" style="display: none;">
            @if (Model.RecentSessions != null && Model.RecentSessions.Any())
            {
                @foreach (var session in Model.RecentSessions)
                {
                    <div class="activity-item">
                        <div class="activity-icon activity-icon-orange">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                        <div class="activity-content">
                            <div class="activity-text">
                                Sessão de <strong>@session.Movie?.Title</strong> na <strong>@session.Room?.Name</strong>
                            </div>
                            <div class="activity-time">
                                @session.StartTime.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-activity">
                    <i class="bi bi-calendar-event"></i>
                    <p>Ainda não há sessões adicionadas.</p>
                </div>
            }
        </div>

        <!-- Rooms -->
        <div class="activity-list" data-type="rooms" style="display: none;">
            @if (Model.RecentRooms != null && Model.RecentRooms.Any())
            {
                @foreach (var room in Model.RecentRooms)
                {
                    <div class="activity-item">
                        <div class="activity-icon activity-icon-blue">
                            <i class="bi bi-door-open"></i>
                        </div>
                        <div class="activity-content">
                            <div class="activity-text">
                                Sala <strong>@room.Name</strong> foi adicionada
                            </div>
                            <div class="activity-time">
                                Capacidade: @room.Capacity lugares
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-activity">
                    <i class="bi bi-door-open"></i>
                    <p>Ainda não há salas adicionadas.</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Activity Filter Dropdown
    const activityFilterBtn = document.getElementById('activityFilterBtn');
    const activityFilterMenu = document.getElementById('activityFilterMenu');
    const activityFilterText = document.getElementById('activityFilterText');
    const activityFilterItems = document.querySelectorAll('#activityFilterMenu .dropdown-item-action');
    const activityDropdownContainer = activityFilterBtn.parentElement;

    // Toggle dropdown
    activityFilterBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        activityFilterMenu.classList.toggle('show');
        activityDropdownContainer.classList.toggle('active');
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', function(e) {
        if (!activityFilterBtn.contains(e.target) && !activityFilterMenu.contains(e.target)) {
            activityFilterMenu.classList.remove('show');
            activityDropdownContainer.classList.remove('active');
        }
    });

    // Filter items click handler
    activityFilterItems.forEach(item => {
        item.addEventListener('click', function(e) {
            e.preventDefault();
            const filterType = this.dataset.filter;
            const filterText = this.querySelector('span').textContent;
            
            // Update button text
            activityFilterText.textContent = filterText;
            
            // Hide all activity lists
            const activityLists = document.querySelectorAll('.activity-list');
            activityLists.forEach(list => {
                if (list.dataset.type === filterType) {
                    list.style.display = 'block';
                } else {
                    list.style.display = 'none';
                }
            });
            
            // Close dropdown
            activityFilterMenu.classList.remove('show');
            activityDropdownContainer.classList.remove('active');
        });
    });
</script>
