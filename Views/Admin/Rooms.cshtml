@model IEnumerable<CinemaRocha.Models.Room>

@{
    ViewData["Title"] = "Gerir Salas";
    Layout = "_AdminLayout";
}

<div class="admin-header">
    <div>
        <h1 class="h2 fw-bold">Salas</h1>
        <p class="text-muted">Gerir as salas de cinema</p>
    </div>
    <a asp-action="CreateRoom" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nova Sala
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Nome</th>
                        <th>Capacidade</th>
                        <th>Lugares Gerados</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Name</td>
                            <td>@item.Capacity pessoas</td>
                            <td>
                                <span class="badge bg-secondary">Auto-gerados</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="EditRoom" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="DeleteRoom" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Tem a certeza?');">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
