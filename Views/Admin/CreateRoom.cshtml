@model CinemaRocha.Models.Room

@{
    ViewData["Title"] = "Nova Sala";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-transparent border-0 pt-4 pb-0">
                    <h3 class="card-title fw-bold">Criar Nova Sala</h3>
                    <p class="text-muted small">Os lugares serão gerados automaticamente.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateRoom">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Nome da Sala</label>
                            <input asp-for="Name" class="form-control" placeholder="Ex: Sala 1, IMAX..." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Capacity" class="form-label">Capacidade</label>
                            <input asp-for="Capacity" class="form-control" type="number" min="10" max="500" />
                            <div class="form-text">Recomendado: entre 20 e 200 lugares.</div>
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Rooms" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">Criar Sala</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
