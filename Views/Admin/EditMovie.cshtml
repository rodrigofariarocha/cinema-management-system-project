@model CinemaRocha.Models.Movie

@{
    ViewData["Title"] = "Editar Filme";
    Layout = "_AdminLayout";
}

<style>
    .edit-header {
        margin-bottom: 32px;
    }

    .edit-header h1 {
        font-family: 'Outfit', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
        color: var(--c-text);
    }

    .edit-header p {
        color: var(--c-text-muted);
        margin: 4px 0 0 0;
    }

    .form-section {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--radius-lg);
        padding: 32px;
        margin-bottom: 24px;
    }

    .form-group-clean {
        margin-bottom: 24px;
    }

    .form-label-clean {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--c-text);
        font-size: 0.938rem;
    }

    .form-input-clean {
        width: 100%;
        padding: 12px 16px;
        background: rgba(11, 11, 11, 0.6);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-md);
        color: var(--c-text);
        font-size: 0.938rem;
        transition: all 0.25s ease;
        font-family: 'Outfit', sans-serif;
    }

    .form-input-clean:focus {
        outline: none;
        border-color: var(--c-primary);
        box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.1);
        background: rgba(11, 11, 11, 0.8);
    }

    textarea.form-input-clean {
        min-height: 120px;
        resize: vertical;
    }

    .image-preview-section {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--radius-lg);
        padding: 24px;
        text-align: center;
    }

    .preview-label {
        font-weight: 600;
        color: var(--c-text-muted);
        font-size: 0.875rem;
        margin-bottom: 16px;
        display: block;
    }

    .image-preview-box {
        width: 100%;
        max-width: 240px;
        aspect-ratio: 2/3;
        background: linear-gradient(135deg, #1a1a1a 0%, #252525 100%);
        border-radius: var(--radius-md);
        overflow: hidden;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .image-preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .image-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        color: var(--c-text-muted);
        opacity: 0.3;
    }

    .image-placeholder i {
        font-size: 2.5rem;
    }

    .image-placeholder span {
        font-size: 0.813rem;
    }

    .action-buttons {
        display: flex;
        gap: 16px;
        justify-content: space-between;
        align-items: center;
        margin-top: 32px;
    }

    .btn-cancel {
        padding: 12px 28px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--c-text);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-md);
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
        font-size: 0.938rem;
    }

    .btn-cancel:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateY(-2px);
        color: var(--c-text);
    }

    .btn-save {
        padding: 12px 28px;
        background: var(--c-primary);
        color: white;
        border: none;
        border-radius: var(--radius-md);
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        transition: all 0.25s ease;
        font-size: 0.938rem;
    }

    .btn-save:hover {
        background: #dc2626;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(239, 68, 68, 0.3);
    }
</style>

<div class="edit-header">
    <h1>Editar Filme</h1>
    <p>Atualizar informações do filme</p>
</div>

<form asp-action="EditMovie" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />
    
    <div class="row">
        <div class="col-lg-8">
            <div class="form-section">
                <div class="form-group-clean">
                    <label asp-for="Title" class="form-label-clean">Título</label>
                    <input asp-for="Title" class="form-input-clean" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-clean">
                        <label asp-for="Genre" class="form-label-clean">Género</label>
                        <input asp-for="Genre" class="form-input-clean" />
                        <span asp-validation-for="Genre" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 form-group-clean">
                        <label asp-for="Duration" class="form-label-clean">Duração (minutos)</label>
                        <input asp-for="Duration" class="form-input-clean" type="number" />
                        <span asp-validation-for="Duration" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group-clean">
                    <label asp-for="Description" class="form-label-clean">Sinopse</label>
                    <textarea asp-for="Description" class="form-input-clean"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group-clean">
                    <label asp-for="ImageUrl" class="form-label-clean">URL da Imagem (Poster)</label>
                    <input asp-for="ImageUrl" class="form-input-clean" id="imageUrlInput" />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                </div>

                <div class="form-group-clean">
                    <label asp-for="TrailerUrl" class="form-label-clean">URL do Trailer (YouTube)</label>
                    <input asp-for="TrailerUrl" class="form-input-clean" placeholder="https://www.youtube.com/watch?v=..." />
                    <span asp-validation-for="TrailerUrl" class="text-danger"></span>
                </div>

                <div class="form-group-clean">
                    <label asp-for="LogoUrl" class="form-label-clean">URL do Logo (opcional)</label>
                    <input asp-for="LogoUrl" class="form-input-clean" placeholder="https://..." />
                    <span asp-validation-for="LogoUrl" class="text-danger"></span>
                </div>


                <div class="form-group-clean">
                    <label asp-for="ReleaseDate" class="form-label-clean">Data de Lançamento</label>
                    <input asp-for="ReleaseDate" class="form-input-clean" type="date" />
                    <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="image-preview-section">
                <span class="preview-label">Pré-visualização do Poster</span>
                <div class="image-preview-box">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" 
                             alt="@Model.Title" 
                             id="previewImage"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                        <div class="image-placeholder" style="display: none;">
                            <i class="bi bi-film"></i>
                            <span>Sem imagem</span>
                        </div>
                    }
                    else
                    {
                        <div class="image-placeholder">
                            <i class="bi bi-film"></i>
                            <span>Sem imagem</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="action-buttons">
        <a asp-action="Movies" class="btn-cancel">
            Cancelar
        </a>
        <button type="submit" class="btn-save">
            Guardar Alterações <i class="bi bi-check-lg"></i>
        </button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Live preview when URL changes
        const imageUrlInput = document.getElementById('imageUrlInput');
        const previewImage = document.getElementById('previewImage');
        
        if (imageUrlInput && previewImage) {
            imageUrlInput.addEventListener('input', function() {
                const url = this.value.trim();
                if (url) {
                    previewImage.src = url;
                    previewImage.style.display = 'block';
                    previewImage.nextElementSibling.style.display = 'none';
                }
            });
        }
    </script>
}
