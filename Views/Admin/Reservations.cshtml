@model IEnumerable<CinemaRocha.Models.Reservation>

@{
    ViewData["Title"] = "Reservas";
    Layout = "_AdminLayout";
}

<style>
    .reservations-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
    }

    .reservations-header h1 {
        font-family: 'Outfit', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
        color: var(--c-text);
    }

    .btn-back {
        padding: 10px 20px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--c-text);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-back:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateX(-3px);
        color: var(--c-text);
    }

    .reservations-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .stat-box {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-lg);
        padding: 20px;
    }

    .stat-value {
        font-family: 'Outfit', sans-serif;
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--c-primary);
        margin: 0 0 4px 0;
    }

    .stat-label {
        font-size: 0.875rem;
        color: var(--c-text-muted);
        margin: 0;
    }

    .reservations-table {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .reservations-table table {
        width: 100%;
        border-collapse: collapse;
    }

    .reservations-table thead {
        background: rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .reservations-table th {
        padding: 16px 20px;
        text-align: left;
        font-size: 0.813rem;
        font-weight: 600;
        color: var(--c-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .reservations-table td {
        padding: 16px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        color: var(--c-text);
        font-size: 0.938rem;
    }

    .reservations-table tbody tr {
        transition: background 0.2s ease;
    }

    .reservations-table tbody tr:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .reservation-id {
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        color: var(--c-primary);
    }

    .user-email {
        font-size: 0.875rem;
        color: var(--c-text-muted);
    }

    .movie-title {
        font-weight: 500;
        color: var(--c-text);
    }

    .price {
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        color: var(--c-primary);
        font-size: 1rem;
    }

    .date-info {
        font-size: 0.875rem;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: var(--c-text-muted);
    }

    .empty-state i {
        font-size: 4rem;
        opacity: 0.2;
        margin-bottom: 20px;
        display: block;
    }

    .empty-state p {
        font-size: 1.125rem;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .reservations-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .reservations-stats {
            grid-template-columns: 1fr;
        }

        .reservations-table th,
        .reservations-table td {
            padding: 12px 16px;
            font-size: 0.875rem;
        }
    }
</style>

<div class="reservations-header">
    <div>
        <h1>Gestão de Reservas</h1>
        <p style="color: var(--c-text-muted); margin: 4px 0 0 0; font-size: 0.938rem;">
            @Model.Count() reserva(s) registada(s)
        </p>
    </div>
    <a asp-action="Index" class="btn-back">
        <i class="bi bi-arrow-left"></i> Voltar ao Dashboard
    </a>
</div>

<!-- Statistics -->
<div class="reservations-stats">
    <div class="stat-box">
        <h3 class="stat-value">@Model.Count()</h3>
        <p class="stat-label">Total de Reservas</p>
    </div>
    <div class="stat-box">
        <h3 class="stat-value">@Model.Sum(r => r.TotalPrice).ToString("C")</h3>
        <p class="stat-label">Receita Total</p>
    </div>
    <div class="stat-box">
        <h3 class="stat-value">@Model.Sum(r => r.Seats.Count)</h3>
        <p class="stat-label">Lugares Reservados</p>
    </div>
</div>

<!-- Reservations Table -->
<div class="reservations-table">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Cliente</th>
                        <th>Filme</th>
                        <th>Sala</th>
                        <th>Data da Sessão</th>
                        <th>Lugares</th>
                        <th>Preço</th>
                        <th>Data da Reserva</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reservation in Model)
                    {
                        <tr>
                            <td>
                                <span class="reservation-id">#@reservation.Id</span>
                            </td>
                            <td>
                                <div class="user-email">@reservation.User?.Email</div>
                            </td>
                            <td>
                                <div class="movie-title">@reservation.Session?.Movie?.Title</div>
                            </td>
                            <td>@reservation.Session?.Room?.Name</td>
                            <td>
                                <div class="date-info">
                                    @reservation.Session?.StartTime.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </td>
                            <td>@reservation.Seats.Count</td>
                            <td>
                                <span class="price">@reservation.TotalPrice.ToString("C")</span>
                            </td>
                            <td>
                                <div class="date-info">
                                    @reservation.ReservationDate.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-ticket-perforated"></i>
            <p>Ainda não existem reservas.</p>
        </div>
    }
</div>
