@model CinemaRocha.Models.UserLoyalty
@{
    ViewData["Title"] = "Pontos e Ofertas";
    var userCoupons = ViewBag.UserCoupons as List<CinemaRocha.Models.UserCoupon> ?? new List<CinemaRocha.Models.UserCoupon>();
    var pointsProgress = Model.AvailablePoints % 10;
}

<style>
    .loyalty-page {
        min-height: 100vh;
        padding: 60px 20px 100px;
        background: linear-gradient(to bottom, var(--c-bg-main), var(--c-bg-surface));
    }

    .loyalty-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .loyalty-title {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 40px;
        color: var(--c-text-primary);
        text-align: center;
    }

    .loyalty-title span {
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* Points Card - Large */
    .points-card {
        background: rgba(26, 26, 26, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 50px;
        margin-bottom: 50px;
    }

    .points-main {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-bottom: 40px;
        text-align: center;
    }

    .points-number {
        font-size: 5rem;
        font-weight: 900;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
    }

    .points-text {
        color: var(--c-text-secondary);
        font-size: 1.2rem;
    }

    .progress-section {
        background: rgba(0, 0, 0, 0.3);
        border-radius: 16px;
        padding: 24px;
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 16px;
        font-size: 1rem;
        color: var(--c-text-secondary);
    }

    .progress-bar {
        height: 16px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: var(--gradient-primary);
        border-radius: 8px;
        transition: width 0.5s ease;
    }

    /* Rewards Section */
    .rewards-section {
        margin-top: 40px;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        padding-left: 16px;
        border-left: 4px solid var(--c-primary);
    }

    .section-header h2 {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--c-text-primary);
        margin: 0;
    }

    .section-header i {
        color: var(--c-primary);
        font-size: 1.3rem;
    }

    /* Mini Cards Grid */
    .rewards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .reward-mini-card {
        background: rgba(26, 26, 26, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 20px;
        transition: all 0.3s ease;
    }

    .reward-mini-card:hover {
        border-color: rgba(255, 59, 48, 0.3);
        transform: translateY(-2px);
    }

    .reward-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
    }

    .reward-badge {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .reward-limit {
        color: var(--c-text-muted);
        font-size: 0.75rem;
    }

    .reward-desc {
        color: var(--c-text-secondary);
        font-size: 0.85rem;
        margin-bottom: 16px;
        line-height: 1.5;
    }

    .reward-validity {
        color: var(--c-text-muted);
        font-size: 0.75rem;
        margin-bottom: 16px;
    }

    /* Code Display - Hidden Initially */
    .code-container {
        display: none;
        background: linear-gradient(135deg, rgba(255, 59, 48, 0.1), rgba(255, 59, 48, 0.02));
        border: 1px solid rgba(255, 59, 48, 0.3);
        border-radius: 12px;
        padding: 16px;
        text-align: center;
        margin-bottom: 12px;
        animation: slideDown 0.4s ease;
    }

    .code-container.visible {
        display: block;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .code-number {
        font-family: 'Outfit', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--c-primary);
        letter-spacing: 4px;
        margin-bottom: 10px;
    }

    .btn-copy-small {
        background: transparent;
        border: 1px solid var(--c-primary);
        color: var(--c-primary);
        padding: 6px 14px;
        border-radius: 6px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-copy-small:hover {
        background: var(--c-primary);
        color: white;
    }

    /* Resgatar Button */
    .btn-resgatar {
        width: 100%;
        padding: 14px;
        background: var(--gradient-primary);
        border: none;
        border-radius: 10px;
        color: white;
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-resgatar:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 59, 48, 0.4);
    }

    .btn-resgatar:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-resgatar.used {
        background: rgba(16, 185, 129, 0.2);
        color: #10b981;
    }

    /* Empty State */
    .empty-rewards {
        background: rgba(26, 26, 26, 0.5);
        border: 1px dashed rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 60px 20px;
        text-align: center;
    }

    .empty-rewards i {
        font-size: 3rem;
        color: var(--c-text-muted);
        opacity: 0.3;
        margin-bottom: 16px;
    }

    .empty-rewards h3 {
        color: var(--c-text-secondary);
        font-weight: 600;
        margin-bottom: 8px;
    }

    .empty-rewards p {
        color: var(--c-text-muted);
        font-size: 0.9rem;
    }
</style>

<div class="loyalty-page">
    <div class="loyalty-container">
        <h1 class="loyalty-title">Pontos e <span>Ofertas</span></h1>

        <div class="points-card">
            <div class="points-main">
                <div class="points-number">@Model.AvailablePoints</div>
                <div class="points-text">Pontos<br>Disponíveis</div>
            </div>
            
            <div class="progress-section">
                <div class="progress-header">
                    <span>Próximo bilhete grátis</span>
                    <span>@pointsProgress / 10</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @(pointsProgress * 10)%"></div>
                </div>
            </div>
        </div>

        <div class="rewards-section">
            <div class="section-header">
                <i class="bi bi-gift-fill"></i>
                <h2>As Tuas Recompensas</h2>
            </div>

            @if (userCoupons.Any())
            {
                <div class="rewards-grid">
                    @foreach (var uc in userCoupons)
                    {
                        var isPending = uc.Coupon.Code.StartsWith("PENDING");
                        <div class="reward-mini-card" data-id="@uc.Id">
                            <div class="reward-top">
                                <span class="reward-badge">
                                    <i class="bi bi-ticket-perforated"></i>
                                    1 Bilhete Grátis
                                </span>
                                <span class="reward-limit">1 lugar</span>
                            </div>
                            
                            <p class="reward-desc">
                                Usa este código ao comprar para teres 1 lugar grátis.
                            </p>
                            
                            <div class="reward-validity">
                                <i class="bi bi-calendar"></i>
                                Válido até @uc.Coupon.ValidTo.ToString("dd/MM/yyyy")
                            </div>
                            
                            <div class="code-container" id="code-@uc.Id">
                                <div class="code-number" id="num-@uc.Id">--------</div>
                                <button class="btn-copy-small" onclick="copyCode(@uc.Id)">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                            
                            @if (isPending)
                            {
                                <button class="btn-resgatar" id="btn-@uc.Id" onclick="resgatar(@uc.Id)">
                                    <i class="bi bi-unlock"></i>
                                    Resgatar
                                </button>
                            }
                            else
                            {
                                <button class="btn-resgatar used" disabled>
                                    <i class="bi bi-check-circle"></i>
                                    Já Resgatado
                                </button>
                                <script>
                                    document.addEventListener('DOMContentLoaded', function() {
                                        document.getElementById('code-@uc.Id').classList.add('visible');
                                        document.getElementById('num-@uc.Id').innerText = '@uc.Coupon.Code';
                                    });
                                </script>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-rewards">
                    <i class="bi bi-gift"></i>
                    <h3>Ainda não tens recompensas</h3>
                    <p>Compra 10 bilhetes para ganhar 1 bilhete grátis!</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
async function resgatar(id) {
    const btn = document.getElementById(`btn-${id}`);
    const codeContainer = document.getElementById(`code-${id}`);
    const codeNum = document.getElementById(`num-${id}`);
    
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Gerando...';
    
    try {
        const response = await fetch('/Loyalty/GenerateCode', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userCouponId: id })
        });
        
        const result = await response.json();
        
        if (result.success) {
            // Animate the code reveal
            codeContainer.classList.add('visible');
            
            // Animate numbers
            let count = 0;
            const interval = setInterval(() => {
                const randomNum = Math.floor(Math.random() * 100000000).toString().padStart(8, '0');
                codeNum.innerText = randomNum;
                count++;
                if (count >= 10) {
                    clearInterval(interval);
                    codeNum.innerText = result.code;
                }
            }, 50);
            
            btn.classList.add('used');
            btn.innerHTML = '<i class="bi bi-check-circle"></i> Resgatado!';
        } else {
            alert('Erro: ' + result.message);
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-unlock"></i> Resgatar';
        }
    } catch (error) {
        alert('Erro ao resgatar');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-unlock"></i> Resgatar';
    }
}

function copyCode(id) {
    const code = document.getElementById(`num-${id}`).innerText;
    navigator.clipboard.writeText(code).then(() => {
        const btn = event.target.closest('button');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check"></i> Copiado!';
        setTimeout(() => {
            btn.innerHTML = originalText;
        }, 1500);
    });
}
</script>
