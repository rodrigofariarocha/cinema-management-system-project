@model RochaCinema.Models.Screening

@{
    ViewData["Title"] = "Adicionar Sessão";
}

<div class="py-4">
    <h1 class="mb-4">Adicionar Sessão</h1>
    
    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="form-group">
                    <label for="MovieId" class="form-label">Filme</label>
                    <select asp-for="MovieId" class="form-control" asp-items="ViewBag.MovieId">
                        <option value="">Selecione um filme</option>
                    </select>
                    <span asp-validation-for="MovieId" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label for="TheaterId" class="form-label">Sala</label>
                    <select asp-for="TheaterId" class="form-control" asp-items="ViewBag.TheaterId">
                        <option value="">Selecione uma sala</option>
                    </select>
                    <span asp-validation-for="TheaterId" class="text-danger"></span>
                </div>
                
                <div class="grid grid-cols-2 gap-3">
                    <div class="form-group">
                        <label asp-for="DateTime" class="form-label"></label>
                        <input asp-for="DateTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="DateTime" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="alert alert-info mt-3">
                    <small>Os lugares disponíveis serão automaticamente definidos com base na capacidade da sala selecionada.</small>
                </div>
                
                <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                    <button type="submit" class="btn btn-primary">Criar Sessão</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
