@{
    ViewData["Title"] = "Contactos";
}

<div class="container" style="margin-top: 60px;">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center mb-5">
            <h1 class="section-title mb-3">Contacta-nos</h1>
            <p class="text-muted lead">Estamos aqui para ajudar. Envia-nos uma mensagem ou visita-nos.</p>
        </div>
    </div>

    <div class="row g-5">
        <div class="col-md-6">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-body p-5">
                    <h3 class="h4 fw-bold mb-4">Informações</h3>
                    
                    <div class="d-flex gap-3 mb-4">
                        <div class="text-primary fs-4"><i class="bi bi-geo-alt"></i></div>
                        <div>
                            <h5 class="fw-bold mb-1">Morada</h5>
                            <p class="text-muted mb-0">Rua do Cinema, 123<br>1234-567 Lisboa</p>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mb-4">
                        <div class="text-primary fs-4"><i class="bi bi-envelope"></i></div>
                        <div>
                            <h5 class="fw-bold mb-1">Email</h5>
                            <p class="text-muted mb-0">geral@rochacinema.com</p>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <div class="text-primary fs-4"><i class="bi bi-telephone"></i></div>
                        <div>
                            <h5 class="fw-bold mb-1">Telefone</h5>
                            <p class="text-muted mb-0">+351 21 123 4567</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-body p-5">
                    <h3 class="h4 fw-bold mb-4">Envia uma Mensagem</h3>
                    <form>
                        <div class="mb-3">
                            <label class="form-label">Nome</label>
                            <input type="text" class="form-control" placeholder="O teu nome">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" placeholder="O teu email">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mensagem</label>
                            <textarea class="form-control" rows="4" placeholder="Como podemos ajudar?"></textarea>
                        </div>
                        <button type="button" class="btn btn-primary w-100">Enviar Mensagem</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
