@{
    ViewData["Title"] = "Contactos";
}

<style>
    .contact-container {
        min-height: 100vh;
        padding: 40px 20px 80px;
        background: linear-gradient(to bottom, var(--c-bg-main), var(--c-bg-surface));
    }

    .contact-hero {
        text-align: center;
        margin-bottom: 80px;
        animation: fadeInUp 0.6s ease-out;
    }

    .contact-title {
        font-size: 3.5rem;
        font-weight: 900;
        margin-bottom: 20px;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .contact-subtitle {
        font-size: 1.25rem;
        color: var(--c-text-secondary);
        max-width: 600px;
        margin: 0 auto;
    }

    .contact-content {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }

    .info-card, .form-card {
        background: linear-gradient(135deg, rgba(26, 26, 26, 0.95) 0%, rgba(18, 18, 18, 0.95) 100%);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 48px;
        animation: fadeInUp 0.8s ease-out;
    }

    .card-title {
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 32px;
        color: var(--c-text-primary);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .card-title i {
        color: var(--c-primary);
        font-size: 1.5rem;
    }

    .info-item {
        display: flex;
        gap: 20px;
        padding: 24px;
        margin-bottom: 16px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.3s ease;
    }

    .info-item:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(239, 68, 68, 0.3);
        transform: translateX(8px);
    }

    .info-icon {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(220, 38, 38, 0.2));
        border-radius: 12px;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .info-icon i {
        color: var(--c-primary);
        font-size: 1.5rem;
    }

    .info-content h5 {
        font-size: 0.875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--c-text-muted);
        margin-bottom: 8px;
    }

    .info-content p {
        font-size: 1.125rem;
        color: var(--c-text-primary);
        margin: 0;
        line-height: 1.6;
    }

    .form-group {
        margin-bottom: 24px;
    }

    .form-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--c-text-secondary);
        margin-bottom: 12px;
    }

    .form-input, .form-textarea {
        width: 100%;
        padding: 16px 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        color: var(--c-text-primary);
        font-size: 1rem;
        font-family: 'Outfit', sans-serif;
        transition: all 0.3s ease;
    }

    .form-input:focus, .form-textarea:focus {
        outline: none;
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--c-primary);
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
    }

    .form-input::placeholder, .form-textarea::placeholder {
        color: var(--c-text-muted);
    }

    .form-textarea {
        resize: vertical;
        min-height: 150px;
    }

    .btn-submit {
        width: 100%;
        padding: 18px 32px;
        background: var(--gradient-primary);
        border: none;
        border-radius: 12px;
        color: white;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 20px rgba(239, 68, 68, 0.3);
    }

    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 30px rgba(239, 68, 68, 0.5);
    }

    .btn-submit i {
        margin-left: 8px;
    }

    @@media (max-width: 968px) {
        .contact-content {
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .contact-title {
            font-size: 2.5rem;
        }

        .info-card, .form-card {
            padding: 32px;
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="contact-container">
    <div class="contact-hero">
        <h1 class="contact-title">Contacta-nos</h1>
        <p class="contact-subtitle">Estamos aqui para ajudar. Envia-nos uma mensagem ou visita-nos.</p>
    </div>

    <div class="contact-content">
        <div class="info-card">
            <h3 class="card-title">
                <i class="bi bi-info-circle-fill"></i>
                Informações
            </h3>
            
            <div class="info-item">
                <div class="info-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div class="info-content">
                    <h5>Morada</h5>
                    <p>Rua do Cinema, 123<br>1234-567 Lisboa</p>
                </div>
            </div>

            <div class="info-item">
                <div class="info-icon">
                    <i class="bi bi-envelope-fill"></i>
                </div>
                <div class="info-content">
                    <h5>Email</h5>
                    <p>geral@rochacinema.com</p>
                </div>
            </div>

            <div class="info-item">
                <div class="info-icon">
                    <i class="bi bi-telephone-fill"></i>
                </div>
                <div class="info-content">
                    <h5>Telefone</h5>
                    <p>+351 21 123 4567</p>
                </div>
            </div>
        </div>

        <div class="form-card">
            <h3 class="card-title">
                <i class="bi bi-chat-dots-fill"></i>
                Envia uma Mensagem
            </h3>
            
            <form>
                <div class="form-group">
                    <input type="text" class="form-input" placeholder="Nome">
                </div>

                <div class="form-group">
                    <input type="email" class="form-input" placeholder="Email">
                </div>

                <div class="form-group">
                    <textarea class="form-textarea" placeholder="Mensagem"></textarea>
                </div>

                <button type="button" class="btn-submit">
                    Enviar Mensagem
                    <i class="bi bi-send-fill"></i>
                </button>
            </form>
        </div>
    </div>
</div>
