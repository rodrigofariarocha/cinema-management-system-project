@{
    ViewData["Title"] = "Política de Privacidade";
}

<style>
    .privacy-page {
        min-height: 100vh;
        padding: 80px 20px 100px;
        background: linear-gradient(to bottom, var(--c-bg-main), var(--c-bg-surface));
    }

    .privacy-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .privacy-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 16px;
        color: var(--c-text-primary);
        text-align: center;
    }

    .privacy-title span {
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .privacy-subtitle {
        text-align: center;
        color: var(--c-text-secondary);
        margin-bottom: 50px;
        font-size: 0.95rem;
    }

    .privacy-card {
        background: rgba(26, 26, 26, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 50px;
    }

    .privacy-section {
        margin-bottom: 40px;
    }

    .privacy-section:last-child {
        margin-bottom: 0;
    }

    .privacy-section-title {
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--c-text-primary);
        margin-bottom: 16px;
    }

    .privacy-section-title i {
        color: var(--c-primary);
        font-size: 1.4rem;
    }

    .privacy-section-text {
        color: var(--c-text-secondary);
        line-height: 1.8;
        font-size: 1rem;
    }

    .privacy-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.08);
        margin: 30px 0;
    }

    .contact-box {
        background: rgba(255, 59, 48, 0.08);
        border: 1px solid rgba(255, 59, 48, 0.2);
        border-radius: 16px;
        padding: 24px;
        text-align: center;
    }

    .contact-box a {
        color: var(--c-primary);
        font-weight: 600;
        text-decoration: none;
        transition: opacity 0.2s ease;
    }

    .contact-box a:hover {
        opacity: 0.8;
    }
</style>

<div class="privacy-page">
    <div class="privacy-container">
        <h1 class="privacy-title">Política de <span>Privacidade</span></h1>
        <p class="privacy-subtitle">
            <i class="bi bi-calendar3"></i>
            Última atualização: @DateTime.Now.ToString("dd MMMM yyyy")
        </p>

        <div class="privacy-card">
            <div class="privacy-section">
                <h2 class="privacy-section-title">
                    <i class="bi bi-database"></i>
                    Recolha de Dados
                </h2>
                <p class="privacy-section-text">
                    Nós recolhemos informações que nos forneces diretamente quando crias uma conta, fazes uma reserva ou nos contactas.
                    Isto pode incluir o teu nome, email e detalhes de pagamento.
                </p>
            </div>

            <div class="privacy-divider"></div>

            <div class="privacy-section">
                <h2 class="privacy-section-title">
                    <i class="bi bi-gear"></i>
                    Utilização dos Dados
                </h2>
                <p class="privacy-section-text">
                    Utilizamos os teus dados para processar as tuas reservas, enviar os teus bilhetes digitais e melhorar a tua experiência no nosso site.
                </p>
            </div>

            <div class="privacy-divider"></div>

            <div class="privacy-section">
                <h2 class="privacy-section-title">
                    <i class="bi bi-shield-check"></i>
                    Segurança
                </h2>
                <p class="privacy-section-text">
                    Implementamos medidas de segurança técnicas e organizacionais para proteger os teus dados pessoais contra acesso não autorizado.
                </p>
            </div>

            <div class="privacy-divider"></div>

            <div class="privacy-section">
                <h2 class="privacy-section-title">
                    <i class="bi bi-envelope"></i>
                    Contacto
                </h2>
                <div class="contact-box">
                    <p class="privacy-section-text" style="margin-bottom: 0;">
                        Se tiveres dúvidas sobre a nossa política de privacidade, contacta-nos através de
                        <a href="mailto:privacidade@rochacinema.com">privacidade@rochacinema.com</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
