@{
    ViewData["Title"] = "Política de Privacidade";
}

<div class="container" style="margin-top: 60px;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="section-title mb-4">Política de Privacidade</h1>
            
            <div class="card bg-dark border-secondary p-4 p-md-5">
                <p class="text-muted mb-4">Última atualização: @DateTime.Now.ToString("dd MMMM yyyy")</p>

                <h3 class="h5 fw-bold text-white mb-3">1. Recolha de Dados</h3>
                <p class="text-muted mb-4">
                    Nós recolhemos informações que nos forneces diretamente quando crias uma conta, fazes uma reserva ou nos contactas.
                    Isto pode incluir o teu nome, email e detalhes de pagamento.
                </p>

                <h3 class="h5 fw-bold text-white mb-3">2. Utilização dos Dados</h3>
                <p class="text-muted mb-4">
                    Utilizamos os teus dados para processar as tuas reservas, enviar os teus bilhetes digitais e melhorar a tua experiência no nosso site.
                </p>

                <h3 class="h5 fw-bold text-white mb-3">3. Segurança</h3>
                <p class="text-muted mb-4">
                    Implementamos medidas de segurança técnicas e organizacionais para proteger os teus dados pessoais contra acesso não autorizado.
                </p>

                <h3 class="h5 fw-bold text-white mb-3">4. Contacto</h3>
                <p class="text-muted mb-0">
                    Se tiveres dúvidas sobre a nossa política de privacidade, contacta-nos através de <a href="mailto:privacidade@rochacinema.com" class="text-primary">privacidade@rochacinema.com</a>.
                </p>
            </div>
        </div>
    </div>
</div>
