@model IEnumerable<RochaCinema.Models.Movie>

@{
    ViewData["Title"] = "RochaCinema - Filmes em Cartaz";
}

<div class="hero">
    <h1>Bem-vindo ao RochaCinema</h1>
    <p class="text-muted" style="font-size: 1.125rem; max-width: 600px; margin: 0 auto;">
        Descubra os melhores filmes em exibição e garanta já os seus bilhetes
    </p>
</div>

@if (Model != null && Model.Any())
{
    <h2 class="mb-4">Filmes em Cartaz</h2>
    <div class="movie-grid">
        @foreach (var movie in Model)
        {
            <div class="card movie-card">
                @if (!string.IsNullOrEmpty(movie.PosterUrl))
                {
                    <img src="@movie.PosterUrl" alt="@movie.Title" class="movie-poster" />
                }
                else
                {
                    <div class="movie-poster" style="display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, hsl(var(--muted)) 0%, hsl(var(--card)) 100%);">
                        <span style="font-size: 3rem;">🎬</span>
                    </div>
                }
                <div class="card-body">
                    <h3 class="card-title">@movie.Title</h3>
                    <p class="card-text" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @movie.Description
                    </p>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem;">
                        <span class="badge badge-secondary">@movie.Genre</span>
                        <span class="badge badge-secondary">@movie.DurationMinutes min</span>
                        @if (movie.Rating.HasValue)
                        {
                            <span class="badge badge-primary">⭐ @movie.Rating.Value.ToString("F1")</span>
                        }
                    </div>
                    <a asp-controller="Home" asp-action="MovieDetails" asp-route-id="@movie.Id" class="btn btn-primary" style="width: 100%;">
                        Ver Detalhes e Sessões
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <p style="margin: 0;">Não há filmes em exibição no momento. Volte em breve!</p>
    </div>
}
