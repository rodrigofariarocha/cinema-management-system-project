@model IEnumerable<CinemaRocha.Models.Movie>

@{
    ViewData["Title"] = "Home";
}

<style>
    main {
        padding-top: 0 !important;
    }
</style>

<!-- HERO SECTION - CINEBY STYLE -->
@if (Model.Any())
{
    var heroMovies = Model.Take(5).ToList();
    
    <div class="cineby-hero">
        <div class="hero-slides">
            @for (int i = 0; i < heroMovies.Count; i++)
            {
                var movie = heroMovies[i];
                var backgroundImage = !string.IsNullOrEmpty(movie.BackdropUrl) ? movie.BackdropUrl : movie.ImageUrl;
                <div class="hero-slide @(i == 0 ? "active" : "")">
                    <!-- Backdrop Image -->
                    <div class="backdrop" style="background-image: url('@backgroundImage');"></div>
                    
                    <!-- Gradient Overlay -->
                    <div class="gradient-overlay"></div>
                    
                    <!-- Content -->
                    <div class="hero-container">
                        <div class="hero-content">
                            <!-- Logo or Title -->
                            @if (!string.IsNullOrEmpty(movie.LogoUrl))
                            {
                                <img src="@movie.LogoUrl" alt="@movie.Title" class="movie-logo">
                            }
                            else
                            {
                                <h1 class="movie-title">@movie.Title</h1>
                            }
                            
                            <!-- Badges -->
                            <div class="badges">
                                <span class="badge"><i class="bi bi-star-fill"></i> @(string.IsNullOrEmpty(movie.ImdbRating) ? "---" : movie.ImdbRating)/10</span>
                                <span class="badge">@movie.ReleaseDate.Year</span>
                                <span class="badge">@movie.Genre?.Split(',')[0].Trim()</span>
                            </div>
                            
                            <!-- Description -->
                            <p class="description">@movie.Description</p>
                            
                            <!-- Buttons -->
                            <div class="actions">
                                <a asp-controller="Tickets" asp-action="Details" asp-route-id="@movie.Id" class="btn-play">
                                    <i class="bi bi-ticket-perforated"></i> Comprar Bilhete
                                </a>
                                @if (!string.IsNullOrEmpty(movie.TrailerUrl))
                                {
                                    <a href="#" class="btn-info" onclick="openTrailerModal('@movie.TrailerUrl'); return false;">
                                        <i class="bi bi-play-circle"></i> Ver Trailer
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <!-- Indicators -->
        @if (heroMovies.Count > 1)
        {
            <div class="indicators">
                @for (int i = 0; i < heroMovies.Count; i++)
                {
                    <button class="dot @(i == 0 ? "active" : "")" onclick="goToSlide(@i)"></button>
                }
            </div>
        }
    </div>
    
    <script>
        let currentSlide = 0;
        const slides = document.querySelectorAll('.hero-slide');
        const dots = document.querySelectorAll('.dot');
        const totalSlides = slides.length;
        let slideInterval;

        function showSlide(index) {
            slides.forEach(s => s.classList.remove('active'));
            dots.forEach(d => d.classList.remove('active'));
            slides[index].classList.add('active');
            dots[index].classList.add('active');
            currentSlide = index;
        }

        function nextSlide() {
            showSlide((currentSlide + 1) % totalSlides);
        }

        function goToSlide(index) {
            clearInterval(slideInterval);
            showSlide(index);
            startAutoSlide();
        }

        function startAutoSlide() {
            slideInterval = setInterval(nextSlide, 5000);
        }

        if (totalSlides > 1) startAutoSlide();
    </script>
    
    <style>
        /* ===== CINEBY HERO SECTION - CLEAN REBUILD ===== */
        .cineby-hero {
            position: relative;
            width: 100%;
            height: 85vh;
            min-height: 600px;
            overflow: hidden;
            margin-bottom: 60px;
        }

        .hero-slides {
            position: relative;
            width: 100%;
            height: 100%;
        }

        .hero-slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 1s ease-in-out;
        }

        .hero-slide.active {
            opacity: 1;
            z-index: 1;
        }

        /* Backdrop - Full Screen Background */
        .backdrop {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        /* Gradient Overlay - Dark Left & Bottom */
        .gradient-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                linear-gradient(90deg, rgba(11,11,11,1) 0%, rgba(11,11,11,0.8) 30%, rgba(11,11,11,0.4) 50%, transparent 70%),
                linear-gradient(0deg, rgba(11,11,11,1) 0%, rgba(11,11,11,0.6) 30%, transparent 60%);
            z-index: 2;
        }

        /* Content Container - Centers content vertically like Cineby */
        .hero-container {
            position: absolute;
            top: 60%;
            left: 0;
            right: 0;
            transform: translateY(-50%);
            z-index: 3;
            padding: 0 60px 0 20px;
        }

        .hero-content {
            max-width: 600px;
            margin-left: 180px;
        }

        /* Logo */
        .movie-logo {
            max-width: 300px;
            height: auto;
            margin-bottom: 24px;
            filter: drop-shadow(0 4px 12px rgba(0,0,0,0.8));
        }

        /* Title Fallback */
        .movie-title {
            font-size: 3.5rem;
            font-weight: 900;
            margin-bottom: 20px;
            color: white;
            text-shadow: 0 2px 8px rgba(0,0,0,0.8);
        }

        /* Badges */
        .badges {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .badge {
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 0.9rem;
            font-weight: 600;
            color: white;
            border: 1px solid rgba(255,255,255,0.1);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .badge i {
            color: #fbbf24;
        }

        /* Description */
        .description {
            color: rgba(255,255,255,0.9);
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 28px;
            max-width: 550px;
        }

        /* Buttons */
        .actions {
            display: flex;
            gap: 14px;
        }

        .btn-play, .btn-info {
            padding: 14px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .btn-play {
            background: white;
            color: #0B0B0B;
        }

        .btn-play:hover {
            background: #f0f0f0;
            transform: scale(1.05);
        }

        .btn-info {
            background: rgba(255,255,255,0.15);
            color: white;
            border: 1px solid rgba(255,255,255,0.2);
        }

        .btn-info:hover {
            background: rgba(255,255,255,0.25);
        }

        /* Indicators */
        .indicators {
            position: absolute;
            bottom: 30px;
            right: 60px;
            z-index: 4;
            display: flex;
            gap: 10px;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.3);
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0;
        }

        .dot.active {
            background: white;
            width: 30px;
            border-radius: 5px;
        }

        .dot:hover {
            background: rgba(255,255,255,0.6);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .cineby-hero {
                height: 60vh;
                min-height: 500px;
            }

            .movie-logo {
                max-width: 300px;
            }

            .movie-title {
                font-size: 2.5rem;
            }

            .description {
                font-size: 0.95rem;
            }

            .actions {
                flex-direction: column;
            }

            .btn-play,
            .btn-info {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
}

<!-- MOVIES GRID -->
<section id="now-showing" class="container">
    <h2 class="section-title">Em Exibição</h2>
    
    <div class="movies-grid-premium">
        @foreach (var movie in Model)
        {
            var primaryGenre = movie.Genre?.Split(',')[0].Trim() ?? "Cinema";
            
            <a asp-controller="Tickets" asp-action="Details" asp-route-id="@movie.Id" class="movie-card-premium">
                <div class="movie-poster">
                    <img src="@movie.ImageUrl" alt="@movie.Title Poster">
                    <div class="imdb-badge">
                        <span class="imdb-logo">IMDb</span>
                        <span class="imdb-rating">★ @(string.IsNullOrEmpty(movie.ImdbRating) ? "---" : movie.ImdbRating)</span>
                    </div>
                </div>
                <div class="movie-info">
                    <h3 class="movie-title-premium">@movie.Title</h3>
                    <span class="movie-genre-badge">@primaryGenre</span>
                    <div class="movie-meta-row">
                        <div class="meta-item">
                            <i class="bi bi-star-fill"></i>
                            <span>@(string.IsNullOrEmpty(movie.ImdbRating) ? "---" : movie.ImdbRating)</span>
                        </div>
                        <div class="meta-item">
                            <i class="bi bi-clock"></i>
                            <span>@movie.Duration min</span>
                        </div>
                        <div class="meta-item">
                            <i class="bi bi-calendar3"></i>
                            <span>@movie.ReleaseDate.Year</span>
                        </div>
                    </div>
                </div>
            </a>
        }
    </div>
</section>

<style>
    .movies-grid-premium {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 28px;
        padding: 5px 0 20px;
    }

    .movie-card-premium {
        position: relative;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
        border-radius: 18px;
        overflow: hidden;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-decoration: none;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .movie-card-premium::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(239, 68, 68, 0.15) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.5s ease;
        pointer-events: none;
    }

    .movie-card-premium:hover::before {
        opacity: 1;
    }

    .movie-card-premium:hover {
        transform: translateY(-12px) scale(1.02);
        box-shadow: 
            0 30px 80px rgba(0, 0, 0, 0.7),
            0 0 0 1px rgba(239, 68, 68, 0.4) inset,
            0 0 40px rgba(239, 68, 68, 0.3);
        border-color: rgba(239, 68, 68, 0.6);
    }

    .movie-poster {
        position: relative;
        width: 100%;
        aspect-ratio: 2/3;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(0, 0, 0, 0.5));
    }

    .movie-poster::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40%;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
        opacity: 0;
        transition: opacity 0.4s ease;
        pointer-events: none;
    }

    .movie-card-premium:hover .movie-poster::after {
        opacity: 1;
    }

    .movie-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1), filter 0.4s ease;
    }

    .movie-card-premium:hover .movie-poster img {
        transform: scale(1.15);
        filter: brightness(0.9);
    }

    /* Overlay com botão de ação */
    .movie-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to top, rgba(11, 11, 11, 0.95) 0%, rgba(11, 11, 11, 0.7) 50%, transparent 100%);
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding: 20px;
        opacity: 0;
        transition: opacity 0.4s ease;
        pointer-events: none;
    }

    .movie-card-premium:hover .movie-overlay {
        opacity: 1;
    }

    .movie-overlay-btn {
        background: var(--gradient-primary);
        color: white;
        padding: 12px 28px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 24px rgba(239, 68, 68, 0.4);
        transform: translateY(20px);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: all;
        text-decoration: none;
        letter-spacing: 0.5px;
    }

    .movie-card-premium:hover .movie-overlay-btn {
        transform: translateY(0);
    }

    .movie-overlay-btn:hover {
        transform: translateY(-4px) scale(1.05);
        box-shadow: 0 12px 32px rgba(239, 68, 68, 0.6);
    }

    .imdb-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(245, 197, 24, 0.95);
        backdrop-filter: blur(15px) saturate(180%);
        padding: 7px 13px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1) inset;
        transition: all 0.3s ease;
        z-index: 10;
    }

    .movie-card-premium:hover .imdb-badge {
        transform: scale(1.1);
        box-shadow: 0 10px 30px rgba(245, 197, 24, 0.4);
    }

    .imdb-logo {
        font-family: 'Outfit', sans-serif;
        font-weight: 900;
        font-size: 0.7rem;
        color: #000;
        letter-spacing: 0.5px;
    }

    .imdb-rating {
        font-weight: 900;
        font-size: 0.85rem;
        color: #000;
    }

    .movie-info {
        padding: 18px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex-grow: 1;
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0.02), transparent);
    }

    .movie-genre-badge {
        padding: 6px 12px;
        background: rgba(239, 68, 68, 0.15);
        backdrop-filter: blur(10px);
        color: #ff6b6b;
        border-radius: 8px;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        border: 1px solid rgba(239, 68, 68, 0.3);
        align-self: flex-start;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
        transition: all 0.3s ease;
    }

    .movie-card-premium:hover .movie-genre-badge {
        background: rgba(239, 68, 68, 0.25);
        border-color: rgba(239, 68, 68, 0.5);
        box-shadow: 0 6px 16px rgba(239, 68, 68, 0.4);
    }

    .movie-title-premium {
        font-family: 'Outfit', sans-serif;
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--c-text);
        margin: 0;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: all 0.3s ease;
        letter-spacing: -0.3px;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    .movie-card-premium:hover .movie-title-premium {
        color: #ef4444;
        text-shadow: 0 0 20px rgba(239, 68, 68, 0.5);
    }

    .movie-meta-row {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: auto;
        padding-top: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 4px;
        color: var(--c-text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .movie-card-premium:hover .meta-item {
        color: var(--c-text-secondary);
    }

    .meta-item i {
        font-size: 0.75rem;
    }

    .meta-item:first-child {
        color: #fbbf24;
    }

    .meta-item:first-child i {
        color: #fbbf24;
        filter: drop-shadow(0 0 4px rgba(251, 191, 36, 0.5));
    }

    .meta-item:first-child span {
        color: var(--c-text);
        font-weight: 800;
    }

    /* Animação de entrada */
    @@keyframes movieCardFadeIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .movie-card-premium {
        animation: movieCardFadeIn 0.6s ease-out both;
    }

    .movie-card-premium:nth-child(1) { animation-delay: 0.05s; }
    .movie-card-premium:nth-child(2) { animation-delay: 0.1s; }
    .movie-card-premium:nth-child(3) { animation-delay: 0.15s; }
    .movie-card-premium:nth-child(4) { animation-delay: 0.2s; }
    .movie-card-premium:nth-child(5) { animation-delay: 0.25s; }
    .movie-card-premium:nth-child(6) { animation-delay: 0.3s; }

    @@media (max-width: 768px) {
        .movies-grid-premium {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 20px;
        }

        .movie-card-premium:hover {
            transform: translateY(-8px) scale(1.01);
        }

        .movie-info {
            padding: 16px 14px;
            gap: 8px;
        }

        .movie-title-premium {
            font-size: 1rem;
        }

        .imdb-badge {
            padding: 6px 10px;
            gap: 4px;
        }

        .imdb-logo,
        .imdb-rating {
            font-size: 0.7rem;
        }

        .movie-meta-row {
            gap: 10px;
        }

        .meta-item {
            font-size: 0.75rem;
        }

        .movie-overlay-btn {
            padding: 10px 20px;
            font-size: 0.85rem;
        }
    }
</style>
