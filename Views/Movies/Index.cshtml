@model IEnumerable<RochaCinema.Models.Movie>

@{
    ViewData["Title"] = "Gestão de Filmes";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestão de Filmes</h1>
        <a asp-action="Create" class="btn btn-primary">+ Adicionar Filme</a>
    </div>
    
    @if (Model != null && Model.Any())
    {
        <div class="card">
            <table class="table">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Género</th>
                        <th>Duração</th>
                        <th>Lançamento</th>
                        <th>Classificação</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movie in Model)
                    {
                        <tr>
                            <td style="font-weight: 600;">@movie.Title</td>
                            <td>@movie.Genre</td>
                            <td>@movie.DurationMinutes min</td>
                            <td>@movie.ReleaseDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (movie.Rating.HasValue)
                                {
                                    <span>⭐ @movie.Rating.Value.ToString("F1")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <div style="display: flex; gap: 0.5rem;">
                                    <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-sm btn-secondary">Ver</a>
                                    <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-sm btn-primary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-sm btn-danger">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p style="margin: 0;">Nenhum filme registado. Clique em "Adicionar Filme" para começar.</p>
        </div>
    }
</div>
