@model CinemaRocha.Models.Reservation

@{
    ViewData["Title"] = "Reserva Confirmada";
}

<div class="confirmation-container">
    <!-- Success Header -->
    <div class="success-header">
        <div class="success-icon-wrapper">
            <div class="success-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="success-ripple"></div>
            <div class="success-ripple ripple-2"></div>
        </div>
        <h1 class="success-title">Reserva Confirmada!</h1>
        <p class="success-subtitle">Obrigado pela tua compra. O teu bilhete digital está pronto.</p>
    </div>

    <!-- Premium Ticket Card -->
    <div class="ticket-container">
        <div class="premium-ticket">
            <!-- Ticket Header with Movie Info -->
            <div class="ticket-header">
                <div class="movie-showcase">
                    <div class="movie-poster">
                        <img src="@Model.Session.Movie.ImageUrl" alt="@Model.Session.Movie.Title">
                        <div class="poster-overlay"></div>
                    </div>
                    <div class="movie-details">
                        <h2 class="movie-title">@Model.Session.Movie.Title</h2>
                        <div class="movie-meta">
                            <span class="meta-item">
                                <i class="bi bi-film"></i>
                                @Model.Session.Movie.Genre
                            </span>
                            <span class="meta-separator">•</span>
                            <span class="meta-item">
                                <i class="bi bi-clock"></i>
                                @Model.Session.Movie.Duration min
                            </span>
                        </div>
                        <div class="room-info" style="border-radius: 8px;">
                            <i class="bi bi-geo-alt-fill"></i>
                            <span>@Model.Session.Room.Name</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dashed Separator -->
            <div class="ticket-separator">
                <div class="separator-line"></div>
            </div>

            <!-- Ticket Body -->
            <div class="ticket-body">
                <div class="session-info">
                    <div class="info-group">
                        <span class="info-label">Data</span>
                        <span class="info-value">@Model.Session.StartTime.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="info-group">
                        <span class="info-label">Hora</span>
                        <span class="info-value">@Model.Session.StartTime.ToString("HH:mm")</span>
                    </div>
                    <div class="info-group">
                        <span class="info-label">Bilhetes</span>
                        <span class="info-value">@Model.Seats.Count</span>
                    </div>
                </div>

                <div class="seats-section">
                    <span class="section-label">Lugares Reservados</span>
                    <div class="seats-grid">
                        @foreach (var seat in Model.Seats)
                        {
                            <div class="seat-badge">
                                <i class="bi bi-wallet2"></i>
                                <span>@seat.Row@seat.Number</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="qr-section">
                    <div class="qr-wrapper">
                        <div class="qr-glow"></div>
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=ROCHA-@Model.Id" 
                             alt="QR Code" 
                             crossorigin="anonymous"
                             class="qr-code">
                    </div>
                    <p class="qr-instruction">
                        <i class="bi bi-phone"></i>
                        Apresenta este código à entrada do cinema
                    </p>
                    <div class="booking-reference">
                        <span class="reference-label">Referência:</span>
                        <span class="reference-code">ROCHA-@Model.Id.ToString().PadLeft(6, '0')</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <a asp-controller="Home" asp-action="Index" class="btn-secondary-action">
                <i class="bi bi-house-door"></i>
                Início
            </a>
            <a asp-action="DownloadTicket" asp-route-id="@Model.Id" target="_blank" class="btn-download-action" style="text-decoration:none">
                <i class="bi bi-file-earmark-pdf-fill"></i>
                Download PDF
            </a>
            <a asp-action="MyTickets" class="btn-primary-action">
                <i class="bi bi-ticket-perforated"></i>
                Meus Bilhetes
            </a>
        </div>
    </div>
    </div>
</div>

<style>
    .confirmation-container {
        min-height: 100vh;
        background: linear-gradient(to bottom, var(--c-bg-main), var(--c-bg-surface));
        padding: 60px 20px;
    }

    /* Success Header */
    .success-header {
        text-align: center;
        margin-bottom: 60px;
        animation: fadeInUp 0.6s ease-out;
    }

    .success-icon-wrapper {
        position: relative;
        display: inline-block;
        margin-bottom: 24px;
    }

    .success-icon {
        position: relative;
        z-index: 2;
    }

    .success-icon i {
        font-size: 5rem;
        color: #10b981;
        filter: drop-shadow(0 0 20px rgba(16, 185, 129, 0.5));
        animation: successPop 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }

    .success-ripple {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 80px;
        height: 80px;
        border: 3px solid #10b981;
        border-radius: 50%;
        animation: ripple 2s ease-out infinite;
    }

    .ripple-2 {
        animation-delay: 1s;
    }

    @@keyframes successPop {
        0% {
            transform: scale(0);
            opacity: 0;
        }
        50% {
            transform: scale(1.2);
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes ripple {
        0% {
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.8;
        }
        100% {
            transform: translate(-50%, -50%) scale(2.5);
            opacity: 0;
        }
    }

    .success-title {
        font-size: 3rem;
        font-weight: 900;
        margin-bottom: 16px;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .success-subtitle {
        font-size: 1.2rem;
        color: var(--c-text-secondary);
    }

    /* Ticket Container */
    .ticket-container {
        max-width: 600px;
        margin: 0 auto;
    }

    .premium-ticket {
        background: linear-gradient(135deg, rgba(26, 26, 26, 0.98) 0%, rgba(18, 18, 18, 0.98) 100%);
        backdrop-filter: blur(20px);
        border: none;
        border-radius: 24px;
        overflow: hidden;
        position: relative;
        box-shadow: none;
        animation: fadeInUp 0.8s ease-out 0.3s both;
    }

    /* Ticket Header */
    .ticket-header {
        padding: 40px;
        background: linear-gradient(135deg, rgba(255, 59, 48, 0.1), transparent);
    }

    .movie-showcase {
        display: flex;
        gap: 24px;
        align-items: flex-start;
    }

    .movie-poster {
        position: relative;
        width: 120px;
        flex-shrink: 0;
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }

    .movie-poster img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        display: block;
    }

    .poster-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
    }

    .movie-details {
        flex: 1;
    }

    .movie-title {
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 12px;
        color: var(--c-text-primary);
    }

    .movie-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--c-text-secondary);
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.95rem;
    }

    .meta-item i {
        color: var(--c-primary);
    }

    .meta-separator {
        color: var(--c-text-muted);
    }

    .room-info {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 59, 48, 0.15);
        border: 1px solid rgba(255, 59, 48, 0.3);
        color: var(--c-primary);
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    /* Separator */
    .ticket-separator {
        position: relative;
        height: 1px;
        margin: 0 40px;
    }

    .separator-line {
        border-top: 2px dashed var(--c-border);
    }

    /* Ticket Body */
    .ticket-body {
        padding: 40px;
    }

    .session-info {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-bottom: 32px;
        padding-bottom: 32px;
        border-bottom: 1px solid var(--c-border);
    }

    .info-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .info-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--c-text-muted);
    }

    .info-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--c-text-primary);
    }

    .seats-section {
        margin-bottom: 40px;
    }

    .section-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--c-text-muted);
        margin-bottom: 16px;
    }

    .seats-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .seat-badge {
        background: linear-gradient(145deg, #2a2a2a, #1a1a1a);
        border: 2px solid var(--c-primary);
        color: var(--c-primary);
        padding: 10px 18px;
        border-radius: var(--radius-md);
        font-weight: 700;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 12px rgba(255, 59, 48, 0.2);
        transition: all 0.3s ease;
    }

    .seat-badge:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(255, 59, 48, 0.4);
    }

    .qr-section {
        text-align: center;
        padding-top: 32px;
        border-top: 1px solid var(--c-border);
    }

    .qr-wrapper {
        position: relative;
        display: inline-block;
        margin-bottom: 20px;
    }

    .qr-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 220px;
        height: 220px;
        background: radial-gradient(circle, rgba(255, 59, 48, 0.2), transparent);
        filter: blur(30px);
        animation: qrPulse 3s ease-in-out infinite;
    }

    @@keyframes qrPulse {
        0%, 100% {
            opacity: 0.5;
        }
        50% {
            opacity: 1;
        }
    }

    .qr-code {
        position: relative;
        width: 200px;
        height: 200px;
        padding: 16px;
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .qr-instruction {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: var(--c-text-secondary);
        font-size: 0.95rem;
        margin-bottom: 16px;
    }

    .qr-instruction i {
        color: var(--c-primary);
        font-size: 1.1rem;
    }

    .booking-reference {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: rgba(255, 255, 255, 0.05);
        padding: 12px 24px;
        border-radius: var(--radius-lg);
        border: 1px solid var(--c-border);
    }

    .reference-label {
        font-size: 0.85rem;
        color: var(--c-text-muted);
    }

    .reference-code {
        font-family: 'Courier New', monospace;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--c-primary);
        letter-spacing: 2px;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 20px;
        margin-top: 40px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-secondary-action,
    .btn-primary-action {
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        padding: 14px 32px;
        border-radius: var(--radius-lg);
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-secondary-action {
        background: transparent;
        border: 2px solid var(--c-border-light);
        color: var(--c-text-primary);
    }

    .btn-secondary-action:hover {
        border-color: var(--c-primary);
        color: var(--c-primary);
        transform: translateY(-2px);
    }

    .btn-primary-action {
        background: var(--gradient-primary);
        color: white;
        box-shadow: 0 4px 20px rgba(255, 59, 48, 0.3);
    }

    .btn-primary-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(255, 59, 48, 0.5);
        color: white;
    }

    .btn-download-action {
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        padding: 14px 32px;
        border-radius: var(--radius-lg);
        border: 2px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.05);
        color: var(--c-text-primary);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-download-action:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--c-text-primary);
        transform: translateY(-2px);
    }
    
    .btn-download-action:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .success-title {
            font-size: 2rem;
        }

        .movie-showcase {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .movie-poster {
            width: 150px;
        }

        .movie-poster img {
            height: 225px;
        }

        .session-info {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn-secondary-action,
        .btn-primary-action {
            width: 100%;
            justify-content: center;
        }

        .ticket-header,
        .ticket-body {
            padding: 24px;
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    /* Export Template Styles */
    #export-template {
        width: 800px;
        background: #0a0a0a;
        color: #ffffff;
        padding: 40px;
        font-family: 'Outfit', sans-serif;
        position: absolute;
        left: -9999px;
        top: 0;
        box-sizing: border-box;
        border-radius: 20px;
        background: linear-gradient(145deg, #1a1a1a 0%, #050505 100%);
    }

    .export-header {
        display: flex;
        gap: 30px;
        margin-bottom: 40px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 30px;
    }

    .export-poster {
        width: 160px;
        height: 240px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    
    .export-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .export-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .export-title {
        font-size: 36px; /* Slightly smaller to prevent wrapping */
        font-weight: 800;
        margin: 0 0 12px 0;
        line-height: 1.1;
        color: #ffffff; /* Solid color fixes html2canvas glitch */
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .export-meta {
        font-size: 16px;
        color: #aaaaaa;
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 20px;
    }

    .export-room {
        display: inline-block;
        background: #ff3b30; /* Solid background for better contrast */
        color: #ffffff;
        padding: 6px 14px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .export-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
        background: rgba(255,255,255,0.03);
        padding: 20px;
        border-radius: 12px;
    }

    .export-item label {
        display: block;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        margin-bottom: 6px;
    }

    .export-item span {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
    }

    .export-seats {
        margin-bottom: 30px;
    }
    
    .export-seats label {
         display: block;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        margin-bottom: 12px;
    }

    .export-seats-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .export-seat-badge {
        background: rgba(255, 59, 48, 0.1);
        border: 1px solid rgba(255, 59, 48, 0.3);
        color: #ff3b30;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 16px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .export-footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding-top: 30px;
        border-top: 1px solid rgba(255,255,255,0.1);
    }

    .export-qr {
        background: white;
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .export-qr img {
        width: 180px;
        height: 180px;
        display: block;
    }

    .export-ref {
        background: rgba(255,255,255,0.05);
        padding: 10px 20px;
        border-radius: 8px;
        font-family: monospace;
        letter-spacing: 2px;
        font-size: 18px;
        color: #ff3b30;
    }
    .export-instruction {
        color: #666;
        margin-bottom: 15px;
        font-size: 14px;
    }
</style>

<!-- Dedicated Export Template (Hidden) -->
<div id="export-template">
    <div class="export-header">
        <div class="export-poster">
            <img src="@Model.Session.Movie.ImageUrl" alt="Poster" crossorigin="anonymous">
        </div>
        <div class="export-info">
            <h1 class="export-title">@Model.Session.Movie.Title</h1>
            <div class="export-meta">
                <span>@Model.Session.Movie.Genre</span>
                <span>•</span>
                <span>@Model.Session.Movie.Duration min</span>
            </div>
            <div class="export-room">
                @Model.Session.Room.Name
            </div>
        </div>
    </div>

    <div class="export-grid">
        <div class="export-item">
            <label>Data</label>
            <span>@Model.Session.StartTime.ToString("dd MMM yyyy")</span>
        </div>
        <div class="export-item">
            <label>Hora</label>
            <span>@Model.Session.StartTime.ToString("HH:mm")</span>
        </div>
        <div class="export-item">
            <label>Bilhetes</label>
            <span>@Model.Seats.Count</span>
        </div>
    </div>

    <div class="export-seats">
        <label>Lugares Reservados</label>
        <div class="export-seats-grid">
            @foreach (var seat in Model.Seats)
            {
                <div class="export-seat-badge">
                    <i class="bi bi-wallet2" style="margin-right: 5px;"></i>
                    @seat.Row@seat.Number
                </div>
            }
        </div>
    </div>

    <div class="export-footer">
        <div class="export-qr">
             <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=ROCHA-@Model.Id" alt="QR" crossorigin="anonymous">
        </div>
        <div class="export-instruction">
            Apresenta este código à entrada do cinema
        </div>
        <div class="export-ref">
            Ref: ROCHA-@Model.Id.ToString().PadLeft(6, '0')
        </div>
    </div>
</div>
