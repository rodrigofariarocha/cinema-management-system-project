@model CinemaRocha.Models.Reservation

@{
    ViewData["Title"] = "Reserva Confirmada";
}

<div class="container" style="margin-top: 60px;">
    <div class="text-center mb-5">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
        </div>
        <h1 class="fw-bold">Reserva Confirmada!</h1>
        <p class="text-muted lead">Obrigado pela tua compra. Aqui está o teu bilhete digital.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="ticket-card bg-dark border border-secondary rounded-4 overflow-hidden position-relative">
                <!-- Decorative circles for "tear" effect -->
                <div class="position-absolute top-50 start-0 translate-middle" style="width: 30px; height: 30px; background: var(--c-bg-main); border-radius: 50%; border: 1px solid var(--c-border);"></div>
                <div class="position-absolute top-50 end-0 translate-middle" style="width: 30px; height: 30px; background: var(--c-bg-main); border-radius: 50%; border: 1px solid var(--c-border);"></div>

                <div class="p-4 border-bottom border-secondary border-dashed">
                    <div class="d-flex gap-3">
                        <img src="@Model.Session.Movie.ImageUrl" alt="Poster" style="width: 80px; height: 120px; object-fit: cover; border-radius: 8px;">
                        <div>
                            <h3 class="h5 fw-bold mb-1">@Model.Session.Movie.Title</h3>
                            <p class="text-muted small mb-2">@Model.Session.Movie.Genre • @Model.Session.Movie.Duration min</p>
                            <div class="d-flex align-items-center gap-2 text-primary">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>@Model.Session.Room.Name</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-4">
                    <div class="row mb-4">
                        <div class="col-6">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem; letter-spacing: 1px;">Data</small>
                            <span class="fw-bold fs-5">@Model.Session.StartTime.ToString("dd MMM")</span>
                        </div>
                        <div class="col-6 text-end">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem; letter-spacing: 1px;">Hora</small>
                            <span class="fw-bold fs-5">@Model.Session.StartTime.ToString("HH:mm")</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <small class="text-muted d-block text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 1px;">Lugares</small>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var seat in Model.Seats)
                            {
                                <span class="badge bg-secondary">@seat.Row@seat.Number</span>
                            }
                        </div>
                    </div>

                    <div class="text-center pt-3">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=ROCHA-@Model.Id" alt="QR Code" style="mix-blend-mode: screen; opacity: 0.8;">
                        <p class="small text-muted mt-2">Apresenta este código à entrada</p>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4 d-flex gap-3 justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light">Voltar ao Início</a>
                <a asp-action="MyTickets" class="btn btn-primary">Meus Bilhetes</a>
            </div>
        </div>
    </div>
</div>
